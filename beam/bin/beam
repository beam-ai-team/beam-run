learning_identity_body() {
  require_workspace; ws="$(read_workspace)"; set +e; profile="$(api_read /v2/user/me)"; prc=$?; set -e
  [ "$prc" -eq 0 ] || die "auth_missing" "could not resolve the current Beam user" 3
  user_id="$(printf '%s' "$profile" | extract_user_id)"; [ -n "$user_id" ] || die "internal_error" "current user response did not include an id" 1
  w="$(json_quote "$ws")"; u="$(json_quote "$user_id")"; printf '{"workspaceId":%s,"userId":%s}' "$w" "$u"
}

cmd_learning_discard() {
  agent_id="${1:-}"; issue_id="${2:-}"; confirm=""
  if [ -z "$agent_id" ] || [ -z "$issue_id" ]; then die "validation_error" "usage: beam learning discard <agentId> <issueId> --confirm <issueId>" 2; fi
  shift 2
  while [ $# -gt 0 ]; do case "$1" in --confirm) confirm="${2:-}"; shift 2 ;; *) die "validation_error" "unknown flag for issue discard: $1" 2 ;; esac; done
  [ "$confirm" = "$issue_id" ] || die "confirmation_required" "discarding archives the issue. Obtain approval, then repeat the issue id with --confirm $issue_id" 2
  body="$(learning_identity_body)"; set +e; resp="$(api_write POST "/tool/optimize/issues/$issue_id/discard?agentId=$agent_id" "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "issue discard result is ambiguous; re-read the issue" 5; fi; printf '%s\n' "$resp"
}

cmd_learning_job_action() {
  action="$1"; thread_id="$2"; shift 2; confirm=""; body=""
  [ -n "$thread_id" ] || die "validation_error" "a Learning Hub thread id is required" 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --confirm) confirm="${2:-}"; shift 2 ;;
      --keep-feedbacks) keep="${2:-}"; case "$keep" in true|false) ;; *) die "validation_error" "--keep-feedbacks must be true or false" 2 ;; esac; shift 2; body="{\"keepFeedbacks\":$keep}" ;;
      --feedback) fb="$(json_quote "${2:-}")"; shift 2; body="{\"optimizationFeedback\":$fb}" ;;
      *) die "validation_error" "unknown flag for Learning Hub job action: $1" 2 ;;
    esac
  done
  [ "$confirm" = "$thread_id" ] || die "confirmation_required" "show the job effect, obtain explicit approval, then repeat the thread id with --confirm $thread_id" 2
  if [ "$action" = "reject" ] && [ -z "$body" ]; then die "validation_error" "reject requires --keep-feedbacks true|false" 2; fi
  if [ "$action" = "re-optimize" ] && [ -z "$body" ]; then die "validation_error" "re-optimize requires --feedback text" 2; fi
  require_workspace; set +e; resp="$(api_write POST "/tool/optimize/jobs/$thread_id/$action" "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "job action result is ambiguous; re-read the job" 5; fi; printf '%s\n' "$resp"
}

cmd_learning_resume() {
  agent_id="${1:-}"; confirm=""; [ -n "$agent_id" ] || die "validation_error" "usage: beam learning resume <agentId> --confirm <agentId>" 2; shift
  while [ $# -gt 0 ]; do case "$1" in --confirm) confirm="${2:-}"; shift 2 ;; *) die "validation_error" "unknown flag for resume: $1" 2 ;; esac; done
  [ "$confirm" = "$agent_id" ] || die "confirmation_required" "resuming can consume credits. Obtain approval, then repeat the agent id with --confirm $agent_id" 2
  require_workspace; set +e; resp="$(api_write POST "/tool/optimize/agents/$agent_id/resume-on-hold-jobs" '')"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "resume result is ambiguous; re-read agent issues" 5; fi; printf '%s\n' "$resp"
}

extract_user_id() {
  if command -v jq >/dev/null 2>&1; then jq -r '.id // .user.id // ""';
  elif command -v python3 >/dev/null 2>&1; then python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("id") or (d.get("user") or {}).get("id") or "")';
  else grep -o '"id"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n1 | sed 's/.*"\([^"]*\)"$/\1/'; fi
}

cmd_learning_optimize() {
  agent_id="${1:-}"; issue_id="${2:-}"; confirm=""
  if [ -z "$agent_id" ] || [ -z "$issue_id" ]; then die "validation_error" "usage: beam learning optimize <agentId> <issueId> --confirm <issueId>" 2; fi
  shift 2
  while [ $# -gt 0 ]; do case "$1" in --confirm) confirm="${2:-}"; shift 2 ;; *) die "validation_error" "unknown flag for Learning Hub optimization: $1" 2 ;; esac; done
  [ "$confirm" = "$issue_id" ] || die "confirmation_required" "this consumes tuner credits. Obtain explicit approval, then repeat the issue id with --confirm $issue_id" 2
  body="$(learning_identity_body)"
  set +e; resp="$(api_write POST "/tool/optimize/issues/$issue_id/optimize?agentId=$agent_id" "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "optimization dispatch is ambiguous; inspect the issue before retrying" 5; fi; printf '%s\n' "$resp"
}

cmd_mcp() {
  # NOTE: no auth gate here. On a fresh install the host spawns this before the
  # user has ever run `beam login`; exiting would leave a dead MCP server as the
  # first thing they see. The vendored bridge serves a live "finish setup"
  # session instead, so the agent can explain the next step.
  warn_if_loopback_was_ignored
  key="$(read_key 2>/dev/null || true)"
  emit_event mcp_connected

  # Preferred: vendored stdlib-Python bridge — no npx/uvx, no install step.
  proxy="$(script_dir)/mcp_proxy.py"
  if [ -f "$proxy" ] && command -v python3 >/dev/null 2>&1; then
    bridge_key="$key"
    [ -n "$ACTIVE_INSTANCE_ID" ] && bridge_key=""
    BEAM_API_KEY="$bridge_key" BEAM_MCP_URL="$MCP_URL" BEAM_API_URL="$API_BASE" \
      BEAM_CONFIG_DIR="$CONFIG_DIR" BEAM_SESSION_ID="$SESSION_ID" exec python3 "$proxy"
  fi

  if [ -z "$key" ]; then
    die "auth_missing" "not signed in — run beam login before starting MCP" 3
  fi
  # The endpoint accepts either header; send both so any server build works.
  vendored="$(script_dir)/mcp-proxy"
  if [ -x "$vendored" ]; then exec "$vendored" "$MCP_URL" --transport streamablehttp -H Authorization "Bearer $key" -H x-api-key "$key"; fi
  # uvx -> PyPI mcp-proxy (remote streamable-HTTP -> stdio).
  if command -v uvx >/dev/null 2>&1; then exec uvx mcp-proxy "$MCP_URL" --transport streamablehttp -H Authorization "Bearer $key" -H x-api-key "$key"; fi
  # npx fallback -> mcp-remote (NOT npm `mcp-proxy`, a different, incompatible tool).
  if command -v npx >/dev/null 2>&1; then exec npx -y mcp-remote "$MCP_URL" --header "Authorization: Bearer $key" --header "x-api-key: $key"; fi
  die "internal_error" "no MCP bridge available (python3, uvx and npx all missing). Install Python 3, then restart your agent." 1
}

mcp_registered_hosts() {
  # Print a space-separated list of hosts that have a "beam" MCP entry.
  found=""
  command -v python3 >/dev/null 2>&1 || { printf ''; return 0; }
  for cfg in "$HOME/.claude.json" "$HOME/.cursor/mcp.json"; do
    [ -f "$cfg" ] || continue
    if BEAM_REG_CFG="$cfg" python3 -c 'import json,os,sys
try:
    d=json.load(open(os.environ["BEAM_REG_CFG"]))
except Exception:
    sys.exit(1)
sys.exit(0 if isinstance(d, dict) and "beam" in (d.get("mcpServers") or {}) else 1)' 2>/dev/null; then
      case "$cfg" in
        *".claude.json") found="$found claude" ;;
        *) found="$found cursor" ;;
      esac
    fi
  done
  printf '%s' "${found# }"
}

mcp_handshake() {
  # $1 = key. 0 = /mcp accepted the key, 3 = rejected, 5 = unreachable.
  # NOTE: `initialize` and `tools/list` are NOT authenticated by the endpoint, so
  # they prove reachability only. Call a real tool to actually exercise the key;
  # auth failures come back as HTTP 200 + isError text, never as 401/403.
  body='{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"getCurrentUser","arguments":{}}}'
  # Capture via `if` — see _http_get: toggling errexit here leaks to the caller.
  if out="$(printf '%s' "$body" | curl -sS --connect-timeout 5 --max-time 20 \
    -X POST -H "Content-Type: application/json" \
    -H "Accept: application/json, text/event-stream" \
    -H "Authorization: Bearer $1" --data-binary @- "$MCP_URL" 2>/dev/null)"; then
    rc=0
  else
    rc=$?
  fi
  [ "$rc" -eq 0 ] || return 5
  # A rejected key is always reported as auth text in the body. Anything else
  # that comes back as JSON-RPC means the key was accepted — including a tool's
  # own error (some Beam tools are broken server-side; that is not an auth fault).
  case "$out" in
    *"Invalid API key"*|*"Authentication required"*|*Unauthorized*) return 3 ;;
    *'"jsonrpc"'*|*'"result"'*) return 0 ;;
    *) return 5 ;;
  esac
}

mcp_tools_list() {
  # $1 = key. Print the raw JSON/SSE response from tools/list.
  body='{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}'
  if out="$(printf '%s' "$body" | curl -sS --connect-timeout 5 --max-time 20 \
    -X POST -H "Content-Type: application/json" \
    -H "Accept: application/json, text/event-stream" \
    -H "Authorization: Bearer $1" --data-binary @- "$MCP_URL" 2>/dev/null)"; then rc=0; else rc=$?; fi
  [ "$rc" -eq 0 ] || return 5
  case "$out" in
    *"Invalid API key"*|*"Authentication required"*|*Unauthorized*) return 3 ;;
    *'"tools"'*|*'"result"'*) printf '%s\n' "$out"; return 0 ;;
    *) return 5 ;;
  esac
}

cmd_mcp_check() {
  require_instance_checkout
  requested_tool=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --tool) requested_tool="${2:-}"; shift 2 ;;
      -h|--help) printf 'Usage: beam mcp check [--tool toolName]\n'; return 0 ;;
      *) die "validation_error" "unknown flag for beam mcp check: $1" 2 ;;
    esac
  done
  key="$(read_key 2>/dev/null || true)"
  [ -n "$key" ] || die "auth_missing" "not signed in — run beam login first" 3
  set +e; mcp_handshake "$key"; auth_rc=$?; set -e
  if [ "$auth_rc" -eq 3 ]; then die "auth_invalid" "MCP rejected the saved key — run beam login, then beam register" 3; fi
  if [ "$auth_rc" -ne 0 ]; then die "network_error" "could not reach the MCP endpoint ($MCP_URL)" 5; fi
  set +e; tools_json="$(mcp_tools_list "$key")"; list_rc=$?; set -e
  if [ "$list_rc" -eq 3 ]; then die "auth_invalid" "MCP rejected the saved key — run beam login, then beam register" 3; fi
  if [ "$list_rc" -ne 0 ]; then die "network_error" "MCP tools/list did not return a usable response" 5; fi
  if [ -n "$requested_tool" ]; then
    tool_json="$(json_quote "$requested_tool")"
    # Works for JSON and for Streamable HTTP's `data: {...}` framing.
    if printf '%s' "$tools_json" | grep -E '"name"[[:space:]]*:[[:space:]]*'"$tool_json" >/dev/null 2>&1; then
      printf '{"ok":true,"endpoint":"%s","authenticated":true,"tool":"%s","available":true}\n' "$MCP_URL" "$requested_tool"
      return 0
    fi
    die "mcp_tool_missing" "MCP is healthy but tool '$requested_tool' is unavailable; use the specialist's CLI fallback" 2
  fi
  count="$(printf '%s' "$tools_json" | grep -Eo '"name"[[:space:]]*:[[:space:]]*"[^"]+"' 2>/dev/null | wc -l | tr -d ' ')"
  printf '{"ok":true,"endpoint":"%s","authenticated":true,"toolCount":%s}\n' "$MCP_URL" "${count:-0}"
}

cmd_doctor() {
  fail=0
  printf 'Beam doctor — checking your setup:\n\n'
  printf '  [ok] beam CLI: %s (v%s)\n' "$0" "$VERSION"

  bindir="$(cd "$(dirname "$0")" 2>/dev/null && pwd || printf '')"
  # shellcheck disable=SC2016  # literal $PATH is intentional (it's shown to the user)
  case ":$PATH:" in
    *":$bindir:"*) printf '  [ok] on PATH (%s)\n' "$bindir" ;;
    *) printf '  [--] not on PATH — run beam by full path, or add to your shell rc: export PATH="%s:$PATH"\n' "$bindir" ;;
  esac

  key="$(read_key 2>/dev/null || true)"
  verify_response=""
  if [ -z "$key" ]; then
    if [ "$(profile_count)" -gt 1 ]; then
      printf '  [--] %s Beam instances connected; choose this session with: beam checkout <instance> [workspace]\n' "$(profile_count)"
    else
      printf '  [XX] not signed in — run: beam login\n'
    fi
    fail=1
  else
    set +e; verify_response="$(verify_key "$key")"; vc=$?; set -e
    case "$vc" in
      0) printf '  [ok] API key valid; Beam endpoint reachable\n' ;;
      3) printf '  [XX] API key rejected — run: beam login\n'; fail=1 ;;
      5) printf '  [XX] cannot reach Beam (network/timeout) — check your internet, then retry\n'; fail=1 ;;
    esac
  fi

  ws="$(read_workspace 2>/dev/null || true)"
  if [ -n "$ws" ] && [ -n "$verify_response" ]; then
    workspace_ids="$(printf '%s' "$verify_response" | workspaces_tsv | cut -f1)"
    if printf '%s\n' "$workspace_ids" | grep -Fx -- "$ws" >/dev/null 2>&1; then
      printf '  [ok] workspace set and accessible (%s)\n' "$ws"
    else
      printf '  [XX] saved workspace is no longer accessible — run: beam workspace list, then beam workspace <id>\n'
      fail=1
    fi
  elif [ -n "$ws" ]; then printf '  [--] workspace set but access could not be checked (%s)\n' "$ws"
  else printf '  [--] no default workspace — your agent should ask only when a request is ambiguous\n'; fi

  # The checks that actually predict "my Beam tools don't work": is Beam
  # registered with the host at all, and does /mcp accept this key?
  reg="$(mcp_registered_hosts)"
  if [ -n "$reg" ]; then printf '  [ok] Beam MCP registered in: %s\n' "$reg"
  else printf '  [XX] Beam MCP is not registered with any agent — run: beam register\n'; fail=1; fi

  if [ -n "$key" ]; then
    set +e; mcp_handshake "$key"; mh=$?; set -e
    case "$mh" in
      0) printf '  [ok] MCP endpoint accepted your key\n' ;;
      3) printf '  [XX] MCP endpoint rejected the key — run: beam login, then beam register\n'; fail=1 ;;
      *) printf '  [XX] could not reach the MCP endpoint (%s) — check your network\n' "$MCP_URL"; fail=1 ;;
    esac
  fi

  if [ -f "$(script_dir)/mcp_proxy.py" ] && command -v python3 >/dev/null 2>&1; then
    printf '  [ok] bundled MCP bridge present (stdio hosts need no npx/uvx)\n'
  elif command -v uvx >/dev/null 2>&1 || command -v npx >/dev/null 2>&1; then
    printf '  [ok] MCP bridge runtime available (uvx/npx) — only needed for stdio hosts\n'
  else
    printf '  [XX] no local MCP bridge runtime — install Python 3, then restart your agent\n'; fail=1
  fi

  if [ "$fail" -eq 0 ]; then printf '\nAll good. Try: beam whoami\n'; return 0; fi
  printf '\nSome checks need attention (see [XX] above).\n'; return 3
}

add_to_path_rc() {
  # Idempotently add ~/.local/bin to the user's shell rc so `beam` is typeable.
  #
  # Deliberately does NOT test the current process PATH. An installer launched by
  # a coding agent, a GUI app, or a CI job routinely has a richer PATH than the
  # user's own terminal; trusting it made setup skip this step and then report
  # "beam on your PATH" while `beam` was still command-not-found for the user.
  # Decide from the rc file, which is what their shell actually reads.
  bindir="$HOME/.local/bin"
  sh_name="$(basename "${SHELL:-sh}")"
  case "$sh_name" in
    zsh) rc="$HOME/.zshrc" ;;
    bash) rc="$HOME/.bashrc" ;;
    fish) rc="$HOME/.config/fish/config.fish" ;;
    *) rc="$HOME/.profile" ;;
  esac
  # Already handled — by us previously, or by the user's own PATH management.
  # Returns 0 only when this call wrote the rc line (caller reports "open a new
  # terminal"); 1 means it was already handled.
  if [ -f "$rc" ] && grep -q 'added by beam setup' "$rc" 2>/dev/null; then return 1; fi
  if [ -f "$rc" ] && grep -q '\.local/bin' "$rc" 2>/dev/null; then return 1; fi
  mkdir -p "$(dirname "$rc")" 2>/dev/null || true
  # shellcheck disable=SC2016  # literal $HOME/$PATH must reach the rc file unexpanded
  if [ "$sh_name" = "fish" ]; then
    printf '\n# added by beam setup\nset -gx PATH $HOME/.local/bin $PATH\n' >> "$rc" 2>/dev/null || true
  else
    # shellcheck disable=SC2016  # literal $HOME/$PATH must reach the rc file unexpanded
    printf '\n# added by beam setup\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$rc" 2>/dev/null || true
  fi
  printf '  [ok] added ~/.local/bin to PATH in %s (open a new terminal to pick it up)\n' "$rc"
}

# --- host MCP registration ------------------------------------------------------
# Register Beam through the local stdio bridge so each host session can resolve
# its own checkout. Keys stay in Beam's private config rather than host JSON.

mcp_host_json() {
  # $1 = add|remove ; $2 = config path.
  command -v python3 >/dev/null 2>&1 || return 1
  BEAM_REG_ACTION="$1" BEAM_REG_CFG="$2" BEAM_REG_COMMAND="$(script_dir)/beam" python3 - <<'PY'
import json, os, shutil, sys

action = os.environ["BEAM_REG_ACTION"]
cfg = os.environ["BEAM_REG_CFG"]
command = os.environ["BEAM_REG_COMMAND"]

if os.path.exists(cfg):
    try:
        with open(cfg) as fh:
            data = json.load(fh)
    except Exception:
        sys.exit(1)          # never clobber a config we can't parse
    if not isinstance(data, dict):
        sys.exit(1)
elif action == "remove":
    sys.exit(1)
else:
    data = {}

servers = data.get("mcpServers")
if not isinstance(servers, dict):
    servers = {}

if action == "add":
    servers["beam"] = {
        "command": command,
        "args": ["mcp"],
    }
else:
    if "beam" not in servers:
        sys.exit(1)
    del servers["beam"]

data["mcpServers"] = servers

if os.path.exists(cfg):
    backup = cfg + ".beam-backup"
    if not os.path.exists(backup):
        shutil.copy2(cfg, backup)
else:
    parent = os.path.dirname(cfg)
    if parent:
        os.makedirs(parent, exist_ok=True)

tmp = cfg + ".beam-tmp"
with open(tmp, "w") as fh:
    json.dump(data, fh, indent=2)
os.replace(tmp, cfg)
try:
    os.chmod(cfg, 0o600)
except OSError:
    pass
PY
}

cmd_register() {
  # Registration is keyless; the local bridge resolves the checkout separately
  # for each session from Beam's private config.
  warn_if_loopback_was_ignored
  hosts=""

  # Claude Code: prefer the official CLI when present (it keeps its own bookkeeping).
  if command -v claude >/dev/null 2>&1; then
    if claude mcp add beam -- "$(script_dir)/beam" mcp >/dev/null 2>&1; then
      hosts="claude-code"
    fi
  fi
  # Claude desktop app (and any Claude Code install): the shared ~/.claude.json
  # registry. This is the common case where no `claude` binary exists.
  if [ -z "$hosts" ] && [ -f "$HOME/.claude.json" ]; then
    if mcp_host_json add "$HOME/.claude.json"; then hosts="claude-desktop"; fi
  fi
  if [ -d "$HOME/.cursor" ]; then
    if mcp_host_json add "$HOME/.cursor/mcp.json"; then hosts="$hosts cursor"; fi
  fi
  hosts="${hosts# }"

  if [ -n "$hosts" ]; then
    printf '{"ok":true,"registered":"%s"}\n' "$hosts"
    printf 'Beam connection registered for: %s\n' "$hosts" >&2
    return 0
  fi

  cat >&2 <<EOF
Could not auto-register (no supported host config found, or python3 is missing).
Add a local command MCP server in your agent:
  name=beam  command=$(script_dir)/beam  args=mcp
Then ask your agent to list your Beam agents.
EOF
  return 2
}

path_line() {
  # Honest PATH line: if setup just wrote the shell rc, the user's CURRENT shell
  # still cannot run `beam` — say so instead of claiming success.
  if [ "${path_added:-0}" = "1" ]; then
    printf '  ✅ beam installed — open a NEW terminal for the beam command to work\n'
  else
    printf '  ✅ beam on your PATH\n'
  fi
}

cmd_setup() {
  emit_event install
  # Install + PATH (always).
  bindir="$(cd "$(dirname "$0")" 2>/dev/null && pwd || printf '')"
  mkdir -p "$HOME/.local/bin"
  if [ -n "$bindir" ] && [ "$bindir" != "$HOME/.local/bin" ]; then
    ln -sf "$bindir/beam" "$HOME/.local/bin/beam" 2>/dev/null || cp "$bindir/beam" "$HOME/.local/bin/beam"
    chmod +x "$HOME/.local/bin/beam" 2>/dev/null || true
  fi
  if add_to_path_rc >/dev/null 2>&1; then path_added=1; else path_added=0; fi
  emit_event path_ok

  # Signed in? Verify the key, then resolve the workspace every time onboarding
  # runs. A sole workspace is selected automatically; multiple workspaces are
  # deliberately left unset so the user can choose.
  key="$(read_key 2>/dev/null || true)"
  signed=0; ws=""; ws_name=""; workspace_count=0
  if [ -z "$key" ] && [ "$(profile_count)" -gt 1 ]; then
    if cmd_register >/dev/null 2>&1; then emit_event mcp_connected; fi
    printf '🎉 Beam is connected!\n\n'
    printf '  ✅ Plugin installed\n'
    path_line
    printf '  ✅ %s Beam instances saved\n' "$(profile_count)"
    printf '  ⬜ Choose this session\n'
    printf '\nNext:\n  beam instance list\n  beam checkout <instance> [workspace]\n'
    return 0
  fi
  if [ -n "$key" ] && profile="$(verify_key "$key")"; then
    signed=1
    previous_workspace="$(read_workspace 2>/dev/null || true)"
    resolve_workspace_from_profile "$profile" "$previous_workspace" 0
    if [ "$previous_workspace" != "$resolved_workspace" ]; then
      write_creds "$key" "$resolved_workspace"
    fi
    ws="$resolved_workspace"
    ws_name="$resolved_workspace_name"
  fi

  # Register the MCP server where we safely can (needs signed-in + claude CLI).
  registered=0
  if [ "$signed" = "1" ]; then
    if cmd_register >/dev/null 2>&1; then registered=1; emit_event mcp_connected; fi
  fi

  # ---- onboarding output: success line + emoji checklist + last steps ----
  if [ "$signed" = "0" ]; then
    # A person running setup in a terminal should not have to discover and run
    # a second command just to provide their API key. The login prompt masks
    # input, validates the key before saving it, and registers MCP on success.
    # Agents and CI are non-interactive, so retain explicit, safe next steps
    # for those callers instead of attempting to read a key from stdin.
    if [ -t 0 ]; then
      printf '🔑 Finish setup by signing in now.\n\n' >&2
      cmd_login
      return 0
    fi
    printf '🚀 Beam is installed — one quick step to finish.\n\n'
    printf '  ✅ Plugin installed\n'
    path_line
    printf '  ⬜ Sign in\n'
    printf '\nNext:\n'
    printf '  🔑 Copy a URL from your Beam workspace, create an API key there, then run: beam login\n'
    return 3
  fi

  if [ "$registered" = "1" ]; then printf '🎉 Beam is connected!\n\n'
  else printf '🚀 Almost there — one step left.\n\n'; fi
  printf '  ✅ Plugin installed\n'
  path_line
  printf '  ✅ Signed in\n'
  if [ -n "$ws" ]; then
    if [ -n "$ws_name" ]; then printf '  ✅ Workspace selected: %s\n' "$ws_name"; else printf '  ✅ Workspace selected: %s\n' "$ws"; fi
  elif [ "$workspace_count" -gt 1 ]; then
    printf '  ⬜ Choose a workspace (%s available)\n' "$workspace_count"
  fi
  if [ "$registered" = "1" ]; then
    printf '  ✅ Beam connection registered\n'
    if [ -n "$ws" ]; then
      printf '\nReady:\n'
      printf '  • List my existing agents\n'
      printf '  • Tell me what you would like to automate\n'
    else
      printf '\nWhich workspace would you like to use? I can show a short, searchable list.\n'
    fi
  else
    printf '  ⬜ Register the Beam connection\n'
    printf '\nLast step:\n'
    printf '  Add a local command MCP server in your agent: name=beam command=%s args=mcp\n' "$(script_dir)/beam"
    printf '  Then ask "list my Beam agents" 🚀\n'
  fi
}

cmd_uninstall() {
  removed=""
  # Undo the MCP registration we created, rather than leaving it to the user.
  for cfg in "$HOME/.claude.json" "$HOME/.cursor/mcp.json"; do
    if [ -f "$cfg" ] && mcp_host_json remove "$cfg" 2>/dev/null; then removed="$removed $cfg"; fi
  done
  if command -v claude >/dev/null 2>&1; then claude mcp remove beam >/dev/null 2>&1 || true; fi
  if [ -e "$HOME/.local/bin/beam" ]; then rm -f "$HOME/.local/bin/beam"; removed="$removed ~/.local/bin/beam"; fi
  if [ -d "$HOME/.config/beam-plugin/beam" ]; then rm -rf "$HOME/.config/beam-plugin/beam"; removed="$removed ~/.config/beam-plugin/beam"; fi
  printf '{"ok":true,"removed":"%s"}\n' "${removed# }"
  printf 'Credentials kept in %s (run: beam logout to remove the current instance).\n' "$CONFIG_DIR" >&2
}

main() {
  if [ $# -eq 0 ]; then cmd_help; exit 0; fi
  cmd="$1"; shift
  case "$cmd" in -h|--help|help|--version|version) ;; *) load_session_context ;; esac
  case "$cmd" in
    -h|--help|help) cmd_help ;;
    --version|version) printf 'beam %s\n' "$VERSION" ;;
    setup) cmd_setup "$@" ;;
    doctor) cmd_doctor "$@" ;;
    login) cmd_login "$@" ;;
    logout) cmd_logout ;;
    instance) cmd_instance "$@" ;;
    checkout) cmd_checkout "$@" ;;
    whoami) cmd_whoami "$@" ;;
    workspace) cmd_workspace "$@" ;;
    agents)
      prepare_scoped_session
      sub="${1:-}"; shift || true
      case "$sub" in
        list) cmd_agents_list ;;
        get) cmd_agents_get "$@" ;;
        tools) [ -n "${1:-}" ] || die "validation_error" "usage: beam agents tools <agentId>" 2; cmd_agents_related_get "agent tools" "/agent/$1/tools" ;;
        sub-agents) [ -n "${1:-}" ] || die "validation_error" "usage: beam agents sub-agents <agentId>" 2; cmd_agents_related_get "agent sub-agents" "/agent/$1/mcp-integration" ;;
        files) [ -n "${1:-}" ] || die "validation_error" "usage: beam agents files <agentId>" 2; cmd_agents_related_get "agent context files" "/context/files?agentId=$1" ;;
        history) [ -n "${1:-}" ] || die "validation_error" "usage: beam agents history <agentId>" 2; cmd_agents_related_get "agent graph history" "/agent-graphs/history/$1" ;;
        remove-tools) cmd_agents_remove_tools "$@" ;;
        external-files-add) cmd_agents_external_files_add "$@" ;;
        context-file-delete) cmd_agents_context_file_delete "$@" ;;
        external-files-delete) cmd_agents_external_files_delete "$@" ;;
        change-file-agent) cmd_agents_change_file_agent "$@" ;;
        upload-file) cmd_agents_upload_file "$@" ;;
        transcribe) cmd_agents_transcribe "$@" ;;
        deploy) cmd_agents_deploy "$@" ;;
        publish) cmd_agents_publish "$@" ;;
        delete) cmd_agents_delete "$@" ;;
        *) die "validation_error" "usage: beam agents <list|get|tools|sub-agents|files|history|remove-tools|upload-file|external-files-add|context-file-delete|external-files-delete|change-file-agent|transcribe|deploy|publish|delete>" 2 ;;
      esac ;;
    tasks)
      prepare_scoped_session
      sub="${1:-}"; shift || true
      case "$sub" in
        list) cmd_tasks_list "$@" ;;
        statuses) cmd_tasks_statuses "$@" ;;
        agents) cmd_tasks_agents ;;
        latest) cmd_tasks_latest "$@" ;;
        create) cmd_tasks_create "$@" ;;
        test) cmd_tasks_test "$@" ;;
        get) cmd_tasks_get "$@" ;;
        retry) cmd_tasks_retry "$@" ;;
        approve) cmd_tasks_approve "$@" ;;
        reject) cmd_tasks_reject "$@" ;;
        abort) cmd_tasks_abort "$@" ;;
        delete) cmd_tasks_delete "$@" ;;
        rate) cmd_tasks_rate "$@" ;;
        cancel-wait) cmd_tasks_cancel_wait "$@" ;;
        update-tool) cmd_tasks_update_tool "$@" ;;
        submit-input) cmd_tasks_submit_input "$@" ;;
        *) die "validation_error" "usage: beam tasks <list|statuses|agents|latest|create|test|get|retry|approve|reject|abort|delete|rate|cancel-wait|update-tool|submit-input>" 2 ;;
      esac ;;
    inbox)
      prepare_scoped_session
      sub="${1:-}"; shift || true
      case "$sub" in
        list) cmd_inbox_list "$@" ;;
        unread-count) cmd_inbox_unread_count ;;
        mark-read) cmd_inbox_mark_read "$@" ;;
        delete) cmd_inbox_delete "$@" ;;
        *) die "validation_error" "usage: beam inbox <list|unread-count|mark-read|delete>" 2 ;;
      esac ;;
    integrations)
      prepare_scoped_session
      sub="${1:-}"; shift || true
      case "$sub" in
        list) cmd_integrations_list ;;
        categories) cmd_integrations_categories ;;
        connected) cmd_integrations_connected ;;
        connections) cmd_integrations_connections "$@" ;;
        is-connected) cmd_integrations_is_connected "$@" ;;
        connect) cmd_integrations_payload_write PUT '/integration-provider/add-token-credential' "${1:-}" ;;
        update) cmd_integrations_payload_write PATCH '/integration-provider/update-connection' "${1:-}" ;;
        remove) cmd_integrations_remove "$@" ;;
        set-default) cmd_integrations_set_default "$@" ;;
        custom-create) cmd_integrations_payload_write POST '/custom-integrations' "${1:-}" ;;
        custom-update)
          id="${1:-}"; file="${2:-}"; [ -n "$id" ] || die "validation_error" "usage: beam integrations custom-update <id> <payloadFile>" 2
          cmd_integrations_payload_write PUT "/custom-integrations/$id" "$file" ;;
        custom-remove) cmd_integrations_custom_remove "$@" ;;
        *) die "validation_error" "usage: beam integrations <list|categories|connected|connections|is-connected|connect|update|remove|set-default|custom-create|custom-update|custom-remove>" 2 ;;
      esac ;;
    templates)
      prepare_scoped_session
      sub="${1:-}"; shift || true
      case "$sub" in
        list) cmd_templates_list "$@" ;;
        categories) cmd_templates_categories ;;
        get) cmd_templates_get "$@" ;;
        recommend) cmd_templates_recommend "$@" ;;
        create-agent) cmd_templates_create_agent "$@" ;;
        *) die "validation_error" "usage: beam templates <list|categories|get|recommend|create-agent>" 2 ;;
      esac ;;
    analytics)
      prepare_scoped_session
      sub="${1:-}"; shift || true
      case "$sub" in get) cmd_analytics_get "$@" ;; export) cmd_analytics_export "$@" ;; *) die "validation_error" "usage: beam analytics <get|export>" 2 ;; esac ;;
    views)
      prepare_scoped_session
      sub="${1:-}"; shift || true
      case "$sub" in
        list) cmd_views_list ;;
        get) cmd_views_get "$@" ;;
        records) cmd_views_records "$@" ;;
        linked-records) cmd_views_linked_records "$@" ;;
        create) cmd_views_payload_write POST '/agent-views' "${1:-}" ;;
        delete) cmd_views_delete "$@" ;;
        add-column)
          view_id="${1:-}"; file="${2:-}"; [ -n "$view_id" ] || die "validation_error" "usage: beam views add-column <viewId> <payloadFile>" 2
          cmd_views_payload_write POST "/agent-views/$view_id/columns" "$file" ;;
        update-column)
          view_id="${1:-}"; column_id="${2:-}"; file="${3:-}"
          if [ -z "$view_id" ] || [ -z "$column_id" ]; then die "validation_error" "usage: beam views update-column <viewId> <columnId> <fullPayloadFile>" 2; fi
          cmd_views_payload_write PATCH "/agent-views/$view_id/columns/$column_id" "$file" ;;
        delete-column) cmd_views_delete_column "$@" ;;
        export) cmd_views_export "$@" ;;
        *) die "validation_error" "usage: beam views <list|get|records|linked-records|create|delete|add-column|update-column|delete-column|export>" 2 ;;
      esac ;;
    learning)
      prepare_scoped_session
      sub="${1:-}"; shift || true
      case "$sub" in
        issues) cmd_learning_issues "$@" ;;
        list-issues) cmd_learning_list_issues "$@" ;;
        issue) cmd_learning_issue "$@" ;;
        feedbacks) cmd_learning_feedbacks "$@" ;;
        feedback-summary) cmd_learning_feedback_summary "$@" ;;
        update-feedback) cmd_learning_update_feedback "$@" ;;
        issue-jobs) cmd_learning_issue_jobs "$@" ;;
        job) cmd_learning_job "$@" ;;
        job-activity) cmd_learning_job_activity "$@" ;;
        trend) cmd_learning_trend "$@" ;;
        tools) cmd_learning_tools "$@" ;;
        tool) cmd_learning_tool "$@" ;;
        config) cmd_learning_config "$@" ;;
        set-config) cmd_learning_set_config "$@" ;;
        submit-feedback) cmd_learning_payload_write POST '/tool/optimize/feedbacks/submit' "${1:-}" ;;
        submit-task-feedback) cmd_learning_payload_write POST '/tool/optimize/feedbacks/task-feedback' "${1:-}" ;;
        merge)
          file="${1:-}"; shift || true; cmd_learning_confirmed_payload_write '/tool/optimize/issues/merge' merge "$file" "$@" ;;
        optimize) cmd_learning_optimize "$@" ;;
        discard) cmd_learning_discard "$@" ;;
        approve-job) thread="${1:-}"; shift || true; cmd_learning_job_action approve "$thread" "$@" ;;
        reject-job) thread="${1:-}"; shift || true; cmd_learning_job_action reject "$thread" "$@" ;;
        reoptimize-job) thread="${1:-}"; shift || true; cmd_learning_job_action re-optimize "$thread" "$@" ;;
        cancel-job) thread="${1:-}"; shift || true; cmd_learning_job_action cancel "$thread" "$@" ;;
        run-job) thread="${1:-}"; shift || true; cmd_learning_job_action run "$thread" "$@" ;;
        resume) cmd_learning_resume "$@" ;;
        *) die "validation_error" "usage: beam learning <issues|list-issues|issue|feedbacks|feedback-summary|update-feedback|issue-jobs|job|job-activity|trend|tools|tool|config|set-config|submit-feedback|submit-task-feedback|merge|optimize|discard|approve-job|reject-job|reoptimize-job|cancel-job|run-job|resume>" 2 ;;
      esac ;;
    agent-builder)
      case "${1:-}" in -h|--help) ;; *) prepare_scoped_session ;; esac
      cmd_agent_builder "$@" ;;
    mcp)
      if [ "${1:-}" = "check" ]; then shift; cmd_mcp_check "$@"; else cmd_mcp; fi ;;
    register) cmd_register ;;
    uninstall) cmd_uninstall ;;
    *) die "validation_error" "unknown command: $cmd (try beam --help)" 2 ;;
  esac
}

main "$@"
