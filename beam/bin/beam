#!/bin/sh
# beam — thin agent-oriented CLI for Beam Core.
# Stores credentials under ~/.config/beam/, verifies with /v2/user/me,
# and launches a local stdio MCP proxy to https://api.beamstudio.ai/mcp.
#
# v0.2.0 — activation-v3:
#   - resilient HTTP (timeouts + bounded retries; network vs auth distinguished)
#   - safe credential parsing (no shell-sourcing of the creds file)
#   - no hard python3 dependency (jq -> python3 -> POSIX fallback)
#   - `beam doctor` (human self-diagnosis) and `beam setup` (one-command install)
#   - `beam uninstall`, `beam workspace list`
#   - API key never required on argv (hidden prompt / stdin / env)
#
# v0.4.0 — build & manage agents:
#   - `beam agents get <id>` (inspect one agent)
#   - `beam agents deploy <spec> [--publish] [--dry-run] [--agent-id ID]`
#     (build/update an agent from a spec via the bundled agent-builder graph builder)
#   - `beam agents publish <graphId>` (promote a draft graph — x-api-key)
#   - `beam agents delete <id>` (remove an agent — mints a short-lived Bearer JWT
#     from the API key via /auth/access-token, since the delete route is JWT-gated)
#   - write-capable HTTP layer (_http_send) + api_write / api_bearer helpers
#
# v0.4.1 — activation fixes:
#   - never guess the workspace: with >1 workspace, login leaves it unset and
#     reports the list instead of silently picking workspaces[0]
#   - `beam register` writes the host MCP config itself (Claude desktop, Cursor),
#     instead of printing manual instructions when the `claude` CLI is absent
#   - `beam mcp` uses a vendored stdlib-Python bridge (no npx/uvx needed) and
#     degrades to a live "finish setup" server instead of dying when signed out
#   - `beam doctor` checks what actually breaks: host MCP registration + a real
#     /mcp handshake
#   - `beam uninstall` removes the MCP entries it created
set -eu

VERSION="0.4.1"
REPO="beam-ai-team/beam-run"
API_BASE="${BEAM_API_URL:-https://api.beamstudio.ai}"
MCP_URL="${BEAM_MCP_URL:-https://api.beamstudio.ai/mcp}"
CONFIG_DIR="${BEAM_CONFIG_DIR:-$HOME/.config/beam}"
CREDS_FILE="$CONFIG_DIR/credentials"
# The stdio bridge needs a REMOTE-streamable-HTTP -> stdio proxy:
#   - uvx: PyPI `mcp-proxy` (sparfenyuk) — proven; args: <url> --transport streamablehttp -H ...
#   - npx: `mcp-remote` (geelen) — the npm equivalent. NOT npm `mcp-proxy`, which is a
#     DIFFERENT tool (stdio -> HTTP server) with incompatible args that silently fails.
# Prefer the DIRECT HTTP MCP registration (type:http) — it needs no proxy at all.

die() {
  # Categorical exit codes agents can branch on:
  # 1 internal, 2 validation, 3 auth, 5 network
  msg=$(printf '%s' "$2" | sed 's/\\/\\\\/g; s/"/\\"/g')
  printf '{"error":{"code":"%s","message":"%s"}}\n' "$1" "$msg" >&2
  exit "$3"
}

ensure_config_dir() {
  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR" 2>/dev/null || true
}

# --- credentials (parsed, never sourced) ---------------------------------------

creds_value() {
  # $1 = key name; prints value from CREDS_FILE without executing the file
  if [ ! -f "$CREDS_FILE" ]; then return 1; fi
  line=$(grep "^$1=" "$CREDS_FILE" 2>/dev/null | head -n1) || return 1
  if [ -z "$line" ]; then return 1; fi
  printf '%s' "${line#*=}"
}

read_key() {
  if [ -n "${BEAM_API_KEY:-}" ]; then printf '%s' "$BEAM_API_KEY"; return 0; fi
  creds_value BEAM_API_KEY
}

read_workspace() {
  if [ -n "${BEAM_WORKSPACE_ID:-}" ]; then printf '%s' "$BEAM_WORKSPACE_ID"; return 0; fi
  creds_value BEAM_WORKSPACE_ID
}

write_creds() {
  key="$1"
  workspace="${2:-}"
  ensure_config_dir
  umask 077
  {
    printf 'BEAM_API_KEY=%s\n' "$key"
    if [ -n "$workspace" ]; then printf 'BEAM_WORKSPACE_ID=%s\n' "$workspace"; fi
  } > "$CREDS_FILE"
  chmod 600 "$CREDS_FILE"
}

# --- JSON (jq -> python3 -> POSIX best-effort) ---------------------------------

workspaces_tsv() {
  # reads /v2/user/me JSON on stdin, prints one "id<TAB>name" line per workspace
  if command -v jq >/dev/null 2>&1; then
    jq -r '(.workspaces // [.workspace] // []) | .[]? | select(.id) | "\(.id)\t\(.name // "")"' 2>/dev/null || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    sys.exit(0)
ws=d.get("workspaces") or d.get("workspace") or []
if isinstance(ws, dict):
    ws=[ws]
for w in ws:
    if isinstance(w, dict) and w.get("id"):
        print("%s\t%s" % (w["id"], w.get("name") or ""))' 2>/dev/null || true
  fi
}

extract_workspace_id() {
  # reads /v2/user/me JSON on stdin, prints the first workspace id (or empty).
  # Only safe to use when the caller has confirmed there is exactly ONE workspace —
  # guessing across many is how users land in the wrong (often empty) workspace.
  if command -v jq >/dev/null 2>&1; then
    jq -r 'if .workspaces then (.workspaces[0].id // "") elif .workspace then (.workspace.id // "") else "" end' 2>/dev/null || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    sys.exit(0)
ws=d.get("workspaces") or d.get("workspace") or []
if isinstance(ws, dict):
    print(ws.get("id") or "")
elif isinstance(ws, list) and ws:
    w=ws[0]
    print(w.get("id") if isinstance(w, dict) else "")' 2>/dev/null || true
  else
    # best-effort: first "id":"..." occurrence (guarded; jq/python3 preferred)
    grep -o '"id"[[:space:]]*:[[:space:]]*"[^"]*"' 2>/dev/null | head -n1 | sed 's/.*"\([^"]*\)"$/\1/' || true
  fi
}

# --- resilient HTTP ------------------------------------------------------------
# Returns: 0 ok (body on stdout) - 3 auth - 5 network/other. Bounded retry+backoff.

_http_get() {
  # $1 = full URL ; remaining args = extra curl args (e.g. -H "Name: value")
  url="$1"; shift
  tmp=$(mktemp 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}/beam.$$")
  attempt=1; max=3; delay=1
  while [ "$attempt" -le "$max" ]; do
    # Capture curl's status via an `if` so errexit stays untouched: toggling
    # `set +e`/`set -e` in here silently re-enabled it for the CALLER, which made
    # `beam doctor` abort mid-checklist on a rejected key (the one case it exists for).
    if code=$(curl -sS --connect-timeout 5 --max-time 30 -o "$tmp" -w '%{http_code}' "$@" "$url" 2>/dev/null); then
      cx=0
    else
      cx=$?
    fi
    if [ "$cx" -ne 0 ]; then
      if [ "$attempt" -lt "$max" ]; then sleep "$delay"; delay=$((delay * 2)); attempt=$((attempt + 1)); continue; fi
      rm -f "$tmp"; return 5
    fi
    case "$code" in
      2*) cat "$tmp"; rm -f "$tmp"; return 0 ;;
      401|403) rm -f "$tmp"; return 3 ;;
      5*) if [ "$attempt" -lt "$max" ]; then sleep "$delay"; delay=$((delay * 2)); attempt=$((attempt + 1)); continue; fi
          rm -f "$tmp"; return 5 ;;
      *) rm -f "$tmp"; return 5 ;;
    esac
  done
  rm -f "$tmp"; return 5
}

verify_key() {
  # $1 = key to test; prints /v2/user/me body on success
  _http_get "$API_BASE/v2/user/me" -H "x-api-key: $1"
}

api_request() {
  # $1 = path; uses stored/env key + workspace
  path="$1"
  key="$(read_key)" || return 3
  ws="$(read_workspace 2>/dev/null || true)"
  if [ -n "$ws" ]; then
    _http_get "$API_BASE$path" -H "x-api-key: $key" -H "current-workspace-id: $ws"
  else
    _http_get "$API_BASE$path" -H "x-api-key: $key"
  fi
}

# --- write-capable HTTP (POST/PUT/PATCH/DELETE) --------------------------------
# Like _http_get but sends a method (+ optional JSON body). SINGLE attempt: a write
# is not blindly retried (a 5xx may already have applied). Returns 0 ok (body on
# stdout), 3 auth, 5 network/other.
_http_send() {
  # $1 = method ; $2 = full URL ; $3 = body ('' for none) ; rest = extra curl args
  method="$1"; url="$2"; body="$3"; shift 3
  tmp=$(mktemp 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}/beam.$$")
  # As in _http_get: never toggle errexit here — it leaks to the caller.
  if [ -n "$body" ]; then
    if code=$(printf '%s' "$body" | curl -sS --connect-timeout 5 --max-time 60 \
      -X "$method" -H "Content-Type: application/json" --data-binary @- \
      -o "$tmp" -w '%{http_code}' "$@" "$url" 2>/dev/null); then cx=0; else cx=$?; fi
  else
    if code=$(curl -sS --connect-timeout 5 --max-time 60 \
      -X "$method" -o "$tmp" -w '%{http_code}' "$@" "$url" 2>/dev/null); then cx=0; else cx=$?; fi
  fi
  if [ "$cx" -ne 0 ]; then rm -f "$tmp"; return 5; fi
  case "$code" in
    2*) cat "$tmp"; rm -f "$tmp"; return 0 ;;
    401|403) rm -f "$tmp"; return 3 ;;
    *) rm -f "$tmp"; return 5 ;;
  esac
}

api_write() {
  # $1 = method ; $2 = path ; $3 = body ('' for none). x-api-key + workspace.
  # The /agent-graphs/* routes (create, update, publish) accept the API key.
  method="$1"; path="$2"; body="${3:-}"
  key="$(read_key)" || return 3
  ws="$(read_workspace 2>/dev/null || true)"
  if [ -n "$ws" ]; then
    _http_send "$method" "$API_BASE$path" "$body" -H "x-api-key: $key" -H "current-workspace-id: $ws"
  else
    _http_send "$method" "$API_BASE$path" "$body" -H "x-api-key: $key"
  fi
}

extract_id_token() {
  # reads /auth/access-token JSON on stdin, prints the idToken (or empty)
  if command -v jq >/dev/null 2>&1; then
    jq -r '.idToken // .accessToken // .token // ""' 2>/dev/null || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    sys.exit(0)
print(d.get("idToken") or d.get("accessToken") or d.get("token") or "")' 2>/dev/null || true
  else
    grep -o '"idToken"[[:space:]]*:[[:space:]]*"[^"]*"' 2>/dev/null | head -n1 | sed 's/.*"\([^"]*\)"$/\1/' || true
  fi
}

mint_bearer() {
  # Exchange the stored API key for a short-lived Bearer JWT (idToken). Some routes
  # (agent delete, triggers, webhooks) are JWT-gated and reject the raw API key.
  key="$(read_key)" || return 3
  set +e
  resp="$(_http_send POST "$API_BASE/auth/access-token" "{\"apiKey\":\"$key\"}")"
  rc=$?
  set -e
  [ "$rc" -eq 0 ] || return "$rc"
  tok="$(printf '%s' "$resp" | extract_id_token)"
  [ -n "$tok" ] || return 3
  printf '%s' "$tok"
}

api_bearer() {
  # $1 = method ; $2 = path ; $3 = body ('' for none). Uses a minted Bearer JWT.
  method="$1"; path="$2"; body="${3:-}"
  tok="$(mint_bearer)" || return 3
  ws="$(read_workspace 2>/dev/null || true)"
  if [ -n "$ws" ]; then
    _http_send "$method" "$API_BASE$path" "$body" -H "Authorization: Bearer $tok" -H "current-workspace-id: $ws"
  else
    _http_send "$method" "$API_BASE$path" "$body" -H "Authorization: Bearer $tok"
  fi
}

# Resolve the real directory of this script, following one symlink level
# (~/.local/bin/beam is a symlink into the plugin). Used to locate bundled skills.
script_dir() {
  src="$0"
  if [ -L "$src" ]; then
    target="$(readlink "$src" 2>/dev/null || true)"
    case "$target" in
      /*) src="$target" ;;
      *) src="$(dirname "$src")/$target" ;;
    esac
  fi
  (cd "$(dirname "$src")" 2>/dev/null && pwd) || printf '%s' "$(dirname "$0")"
}

# --- telemetry (local placeholder until a sink is chosen — SPEC-00) ------------

emit_event() {
  if [ "${BEAM_TELEMETRY:-1}" = "0" ]; then return 0; fi
  ensure_config_dir
  if [ ! -f "$CONFIG_DIR/install_id" ]; then
    { command -v uuidgen >/dev/null 2>&1 && uuidgen || date +%s; } > "$CONFIG_DIR/install_id" 2>/dev/null || true
  fi
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf 'now')
  printf '%s stage=%s host=%s os=%s ver=%s\n' "$ts" "$1" "${BEAM_HOST:-unknown}" \
    "$(uname -s 2>/dev/null || printf unknown)" "$VERSION" >> "$CONFIG_DIR/events.log" 2>/dev/null || true
}

# --- commands ------------------------------------------------------------------

cmd_help() {
  cat <<EOF
beam $VERSION — Beam Core CLI for coding agents

Usage:
  beam setup                 guided install: PATH + auth + MCP registration
  beam register              register the Beam MCP server with your agent
  beam doctor                self-diagnose install/auth/connection (human checklist)
  beam login                 sign in (asks for your key; or --api-key -, or BEAM_API_KEY)
  beam logout
  beam whoami
  beam workspace [ID]        show/set current workspace
  beam workspace list [q]    list/search your workspaces (filter by name or id)
  beam agents list           list agents in the current workspace
  beam agents get <id>       inspect one agent
  beam agents deploy <spec>  build/update an agent from a spec (draft; --publish to go live)
  beam agents publish <gid>  publish a draft graph (graphId from deploy output)
  beam agents delete <id>    delete an agent
  beam agent-builder <cmd>   bundled agent builder (design/build/patch graphs)
  beam mcp                   stdio MCP proxy (stdio-only hosts; Claude/Cursor use direct HTTP)
  beam uninstall
  beam --version | --help

Auth (never put the key on the command line — it leaks to shell history):
  beam login                 # asks for your key (stays hidden as you type)
  BEAM_API_KEY=... beam login  # env
  printf '%s' "\$KEY" | beam login --api-key -   # stdin
  Create a key: app.beam.ai -> Personal settings -> API Keys

Docs: https://github.com/$REPO
EOF
}

cmd_login() {
  key=""; workspace=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --api-key) key="${2:-}"; shift 2 ;;
      --workspace-id) workspace="${2:-}"; shift 2 ;;
      -h|--help) cmd_help; exit 0 ;;
      *) die "validation_error" "unknown flag: $1 (try beam login --help)" 2 ;;
    esac
  done
  if [ "$key" = "-" ]; then IFS= read -r key || true; fi
  if [ -z "$key" ] && [ -n "${BEAM_API_KEY:-}" ]; then key="$BEAM_API_KEY"; fi
  if [ -z "$key" ]; then
    if [ -t 0 ]; then
      printf 'Paste your Beam API key and press Enter (it stays hidden as you type): ' >&2
      if command -v stty >/dev/null 2>&1; then
        stty -echo 2>/dev/null || true; IFS= read -r key || true; stty echo 2>/dev/null || true; printf '\n' >&2
      else
        IFS= read -r key || true
      fi
    else
      die "auth_missing" "no key — use: beam login (interactive), BEAM_API_KEY=... beam login, or pipe to --api-key -. Avoid --api-key <key> (leaks to history)." 3
    fi
  fi
  if [ -z "$key" ]; then die "auth_missing" "empty API key" 3; fi

  set +e; resp="$(verify_key "$key")"; vc=$?; set -e
  if [ "$vc" -eq 3 ]; then die "auth_invalid" "API key rejected by $API_BASE/v2/user/me — create a fresh key in app.beam.ai" 3; fi
  if [ "$vc" -eq 5 ]; then die "network_error" "could not reach $API_BASE (network/timeout) — key NOT saved; check your connection and retry" 5; fi

  # Workspace: NEVER guess when there is more than one. Picking workspaces[0]
  # silently drops the user into an arbitrary (often near-empty) workspace, so
  # their first "list my agents" looks broken. Auto-set only when unambiguous.
  ws_count=0
  if [ -z "$workspace" ]; then
    ws_list="$(printf '%s' "$resp" | workspaces_tsv)"
    if [ -n "$ws_list" ]; then ws_count=$(printf '%s\n' "$ws_list" | grep -c .); fi
    prev="$(read_workspace 2>/dev/null || true)"
    if [ -n "$prev" ]; then
      workspace="$prev"                       # keep what the user already chose
    elif [ "$ws_count" -eq 1 ]; then
      workspace="$(printf '%s\n' "$ws_list" | head -n1 | cut -f1)"
    fi
  fi

  write_creds "$key" "$workspace"
  emit_event auth_ok
  printf '{"ok":true,"saved":"%s","workspaceId":%s,"workspaceCount":%s}\n' "$CREDS_FILE" \
    "$(if [ -n "$workspace" ]; then printf '"%s"' "$workspace"; else printf 'null'; fi)" "$ws_count"

  # Wire the MCP connection now that the key is stored (all supported hosts).
  set +e; cmd_register >/dev/null 2>&1; reg=$?; set -e

  printf 'Signed in ✅\n' >&2
  if [ "$reg" -eq 0 ]; then printf 'Beam connection registered ✅\n' >&2; fi
  if [ -z "$workspace" ]; then
    printf '\n⚠️  You have %s workspaces — pick one before listing agents:\n' "$ws_count" >&2
    printf '    beam workspace list <search>   # e.g. beam workspace list acme\n' >&2
    printf '    beam workspace <id>\n' >&2
  fi
  printf '\nNext: fully restart your agent, then ask "list my Beam agents".\n' >&2
}

cmd_logout() {
  if [ -f "$CREDS_FILE" ]; then rm -f "$CREDS_FILE"; fi
  printf '{"ok":true,"loggedOut":true}\n'
}

cmd_whoami() {
  set +e; resp="$(api_request /v2/user/me)"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in or key rejected — run: beam login" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "could not reach $API_BASE (network/timeout)" 5; fi
  ws="$(read_workspace 2>/dev/null || true)"
  if [ -n "$ws" ] && command -v jq >/dev/null 2>&1; then
    printf '%s' "$resp" | jq --arg ws "$ws" --arg api "$API_BASE" '. + {_beam:{workspaceId:$ws,apiBase:$api}}' 2>/dev/null || printf '%s\n' "$resp"
  else
    printf '%s\n' "$resp"
  fi
}

cmd_workspace() {
  if [ "${1:-}" = "list" ]; then
    query="${2:-}"
    set +e; resp="$(api_request /v2/user/me)"; rc=$?; set -e
    if [ "$rc" -ne 0 ]; then die "auth_missing" "run beam login first" 3; fi
    all="$(printf '%s' "$resp" | workspaces_tsv)"
    total=0; [ -n "$all" ] && total=$(printf '%s\n' "$all" | grep -c .)
    if [ -n "$query" ]; then
      shown="$(printf '%s\n' "$all" | grep -i -- "$query" || true)"
    else
      shown="$all"
    fi
    n=0; [ -n "$shown" ] && n=$(printf '%s\n' "$shown" | grep -c .)
    if [ "$n" -eq 0 ]; then
      printf 'No workspace matched "%s" (of %s total). Try a different search.\n' "$query" "$total" >&2
      return 0
    fi
    # Accounts can hold thousands of workspaces — never dump them all.
    printf '%s\n' "$shown" | head -n 25
    if [ "$n" -gt 25 ]; then
      printf '\n… showing 25 of %s matches (%s workspaces total). Narrow it: beam workspace list <search>\n' "$n" "$total" >&2
    fi
    return 0
  fi
  if [ $# -eq 0 ]; then
    workspace="$(read_workspace 2>/dev/null || true)"
    if [ -z "$workspace" ]; then die "validation_error" "no workspace set — run: beam workspace list, then beam workspace <id>" 2; fi
    printf '{"workspaceId":"%s"}\n' "$workspace"
    return 0
  fi
  key="$(read_key)" || die "auth_missing" "not signed in — run beam login first" 3
  write_creds "$key" "$1"
  printf '{"ok":true,"workspaceId":"%s"}\n' "$1"
}

cmd_agents_list() {
  if ! read_workspace >/dev/null 2>&1; then die "validation_error" "no workspace — run: beam workspace list, then beam workspace <id>" 2; fi
  # NOTE: capped at pageSize=50 (no pagination yet — deferred, see specs).
  set +e; resp="$(api_request '/agent?pageNum=1&pageSize=50')"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "agents list failed (network/timeout)" 5; fi
  printf '%s\n' "$resp"
}

cmd_agents_get() {
  id="${1:-}"
  [ -n "$id" ] || die "validation_error" "usage: beam agents get <agentId>" 2
  set +e; resp="$(api_request "/agent/$id")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "agents get failed (network/timeout)" 5; fi
  printf '%s\n' "$resp"
}

cmd_agents_deploy() {
  # Build or update an agent from a spec via the bundled agent-builder graph builder.
  # Draft by default; pass --publish to go live. See skills/agent-builder for the spec format.
  spec="${1:-}"
  [ -n "$spec" ] || die "validation_error" "usage: beam agents deploy <specFile> [--agent-id ID] [--publish] [--dry-run]" 2
  [ -f "$spec" ] || die "validation_error" "spec file not found: $spec" 2
  shift
  command -v python3 >/dev/null 2>&1 || die "internal_error" "beam agents deploy needs python3 (the graph builder). Install Python 3.8+." 1
  key="$(read_key)" || die "auth_missing" "not signed in — run beam login first" 3
  ws="$(read_workspace 2>/dev/null || true)"
  [ -n "$ws" ] || die "validation_error" "no workspace — run: beam workspace list, then beam workspace <id>" 2
  builder="$(script_dir)/../skills/agent-builder/scripts/beam.py"
  [ -f "$builder" ] || die "internal_error" "bundled graph builder not found ($builder) — reinstall the plugin (beam setup)" 1
  BEAM_API_KEY="$key" BEAM_WORKSPACE_ID="$ws" BEAM_API_URL="$API_BASE" python3 "$builder" deploy "$spec" "$@"
}

cmd_agent_builder() {
  # Passthrough to the bundled agent-builder CLI. The skill's docs used to say
  # `python3 scripts/beam.py …`, which only resolves if the agent happens to be
  # cwd'd into the skill directory — it never is, so every documented command
  # failed on a fresh install. Going through `beam` resolves the path here.
  command -v python3 >/dev/null 2>&1 || die "internal_error" "the agent builder needs python3 (3.8+). Install Python, then retry." 1
  builder="$(script_dir)/../skills/agent-builder/scripts/beam.py"
  [ -f "$builder" ] || die "internal_error" "bundled agent builder not found ($builder) — reinstall the plugin, then run: beam setup" 1
  if [ $# -eq 0 ]; then set -- --help; fi
  exec python3 "$builder" "$@"
}

cmd_agents_publish() {
  gid="${1:-}"
  [ -n "$gid" ] || die "validation_error" "usage: beam agents publish <graphId>  (graphId comes from deploy output)" 2
  set +e; resp="$(api_write PATCH "/agent-graphs/$gid/publish" '')"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "publish failed (network/timeout) — graph NOT published" 5; fi
  printf '{"ok":true,"published":"%s"}\n' "$gid"
}

cmd_agents_delete() {
  id="${1:-}"
  [ -n "$id" ] || die "validation_error" "usage: beam agents delete <agentId>" 2
  # DELETE /agent/{id} is JWT-gated; mint a Bearer token from the API key first.
  set +e; resp="$(api_bearer DELETE "/agent/$id" '')"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "delete auth failed (JWT exchange rejected) — run beam login for a fresh key" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "delete failed (network/timeout) — agent NOT deleted" 5; fi
  printf '{"ok":true,"deleted":"%s"}\n' "$id"
}

cmd_mcp() {
  # NOTE: no auth gate here. On a fresh install the host spawns this before the
  # user has ever run `beam login`; exiting would leave a dead MCP server as the
  # first thing they see. The vendored bridge serves a live "finish setup"
  # session instead, so the agent can explain the next step.
  key="$(read_key 2>/dev/null || true)"
  emit_event mcp_connected

  # Preferred: vendored stdlib-Python bridge — no npx/uvx, no install step.
  proxy="$(script_dir)/mcp_proxy.py"
  if [ -f "$proxy" ] && command -v python3 >/dev/null 2>&1; then
    BEAM_API_KEY="$key" BEAM_MCP_URL="$MCP_URL" exec python3 "$proxy"
  fi

  if [ -z "$key" ]; then
    die "auth_missing" "not signed in — run beam login before starting MCP" 3
  fi
  # The endpoint accepts either header; send both so any server build works.
  vendored="$(script_dir)/mcp-proxy"
  if [ -x "$vendored" ]; then exec "$vendored" "$MCP_URL" --transport streamablehttp -H Authorization "Bearer $key" -H x-api-key "$key"; fi
  # uvx -> PyPI mcp-proxy (remote streamable-HTTP -> stdio).
  if command -v uvx >/dev/null 2>&1; then exec uvx mcp-proxy "$MCP_URL" --transport streamablehttp -H Authorization "Bearer $key" -H x-api-key "$key"; fi
  # npx fallback -> mcp-remote (NOT npm `mcp-proxy`, a different, incompatible tool).
  if command -v npx >/dev/null 2>&1; then exec npx -y mcp-remote "$MCP_URL" --header "Authorization: Bearer $key" --header "x-api-key: $key"; fi
  die "internal_error" "no MCP bridge available (python3, uvx and npx all missing). Best fix: run 'beam register' to add Beam as a DIRECT HTTP MCP server — no bridge needed." 1
}

mcp_registered_hosts() {
  # Print a space-separated list of hosts that have a "beam" MCP entry.
  found=""
  command -v python3 >/dev/null 2>&1 || { printf ''; return 0; }
  for cfg in "$HOME/.claude.json" "$HOME/.cursor/mcp.json"; do
    [ -f "$cfg" ] || continue
    if BEAM_REG_CFG="$cfg" python3 -c 'import json,os,sys
try:
    d=json.load(open(os.environ["BEAM_REG_CFG"]))
except Exception:
    sys.exit(1)
sys.exit(0 if isinstance(d, dict) and "beam" in (d.get("mcpServers") or {}) else 1)' 2>/dev/null; then
      case "$cfg" in
        *".claude.json") found="$found claude" ;;
        *) found="$found cursor" ;;
      esac
    fi
  done
  printf '%s' "${found# }"
}

mcp_handshake() {
  # $1 = key. 0 = /mcp accepted the key, 3 = rejected, 5 = unreachable.
  # NOTE: `initialize` and `tools/list` are NOT authenticated by the endpoint, so
  # they prove reachability only. Call a real tool to actually exercise the key;
  # auth failures come back as HTTP 200 + isError text, never as 401/403.
  body='{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"getCurrentUser","arguments":{}}}'
  # Capture via `if` — see _http_get: toggling errexit here leaks to the caller.
  if out="$(printf '%s' "$body" | curl -sS --connect-timeout 5 --max-time 20 \
    -X POST -H "Content-Type: application/json" \
    -H "Accept: application/json, text/event-stream" \
    -H "Authorization: Bearer $1" --data-binary @- "$MCP_URL" 2>/dev/null)"; then
    rc=0
  else
    rc=$?
  fi
  [ "$rc" -eq 0 ] || return 5
  # A rejected key is always reported as auth text in the body. Anything else
  # that comes back as JSON-RPC means the key was accepted — including a tool's
  # own error (some Beam tools are broken server-side; that is not an auth fault).
  case "$out" in
    *"Invalid API key"*|*"Authentication required"*|*Unauthorized*) return 3 ;;
    *'"jsonrpc"'*|*'"result"'*) return 0 ;;
    *) return 5 ;;
  esac
}

cmd_doctor() {
  fail=0
  printf 'Beam doctor — checking your setup:\n\n'
  printf '  [ok] beam CLI: %s (v%s)\n' "$0" "$VERSION"

  bindir="$(cd "$(dirname "$0")" 2>/dev/null && pwd || printf '')"
  # shellcheck disable=SC2016  # literal $PATH is intentional (it's shown to the user)
  case ":$PATH:" in
    *":$bindir:"*) printf '  [ok] on PATH (%s)\n' "$bindir" ;;
    *) printf '  [--] not on PATH — run beam by full path, or add to your shell rc: export PATH="%s:$PATH"\n' "$bindir" ;;
  esac

  key="$(read_key 2>/dev/null || true)"
  if [ -z "$key" ]; then
    printf '  [XX] not signed in — run: beam login   (key from app.beam.ai -> Personal settings -> API Keys)\n'; fail=1
  else
    set +e; verify_key "$key" >/dev/null; vc=$?; set -e
    case "$vc" in
      0) printf '  [ok] API key valid; Beam endpoint reachable\n' ;;
      3) printf '  [XX] API key rejected — run: beam login   (create a fresh key)\n'; fail=1 ;;
      5) printf '  [XX] cannot reach Beam (network/timeout) — check your internet, then retry\n'; fail=1 ;;
    esac
  fi

  ws="$(read_workspace 2>/dev/null || true)"
  if [ -n "$ws" ]; then printf '  [ok] workspace set (%s)\n' "$ws"
  else printf '  [--] no workspace set — run: beam workspace list, then beam workspace <id>\n'; fi

  # The checks that actually predict "my Beam tools don't work": is Beam
  # registered with the host at all, and does /mcp accept this key?
  reg="$(mcp_registered_hosts)"
  if [ -n "$reg" ]; then printf '  [ok] Beam MCP registered in: %s\n' "$reg"
  else printf '  [XX] Beam MCP is not registered with any agent — run: beam register\n'; fail=1; fi

  if [ -n "$key" ]; then
    set +e; mcp_handshake "$key"; mh=$?; set -e
    case "$mh" in
      0) printf '  [ok] MCP endpoint accepted your key\n' ;;
      3) printf '  [XX] MCP endpoint rejected the key — run: beam login (fresh key), then beam register\n'; fail=1 ;;
      *) printf '  [XX] could not reach the MCP endpoint (%s) — check your network\n' "$MCP_URL"; fail=1 ;;
    esac
  fi

  if [ -f "$(script_dir)/mcp_proxy.py" ] && command -v python3 >/dev/null 2>&1; then
    printf '  [ok] bundled MCP bridge present (stdio hosts need no npx/uvx)\n'
  elif command -v uvx >/dev/null 2>&1 || command -v npx >/dev/null 2>&1; then
    printf '  [ok] MCP bridge runtime available (uvx/npx) — only needed for stdio hosts\n'
  else
    printf '  [--] no bundled bridge and no uvx/npx — only matters for stdio hosts; direct HTTP needs neither\n'
  fi

  printf '\n  Reminder: if you signed in AFTER starting your agent, fully restart it so MCP picks up the key.\n'
  if [ "$fail" -eq 0 ]; then printf '\nAll good. Try: beam whoami\n'; return 0; fi
  printf '\nSome checks need attention (see [XX] above).\n'; return 3
}

add_to_path_rc() {
  # Idempotently add ~/.local/bin to the user's shell rc so `beam` is typeable.
  bindir="$HOME/.local/bin"
  case ":$PATH:" in *":$bindir:"*) return 0 ;; esac
  sh_name="$(basename "${SHELL:-sh}")"
  case "$sh_name" in
    zsh) rc="$HOME/.zshrc" ;;
    bash) rc="$HOME/.bashrc" ;;
    fish) rc="$HOME/.config/fish/config.fish" ;;
    *) rc="$HOME/.profile" ;;
  esac
  if [ -f "$rc" ] && grep -q 'added by beam setup' "$rc" 2>/dev/null; then return 0; fi
  mkdir -p "$(dirname "$rc")" 2>/dev/null || true
  # shellcheck disable=SC2016  # literal $HOME/$PATH must reach the rc file unexpanded
  if [ "$sh_name" = "fish" ]; then
    printf '\n# added by beam setup\nset -gx PATH $HOME/.local/bin $PATH\n' >> "$rc" 2>/dev/null || true
  else
    # shellcheck disable=SC2016  # literal $HOME/$PATH must reach the rc file unexpanded
    printf '\n# added by beam setup\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$rc" 2>/dev/null || true
  fi
  printf '  [ok] added ~/.local/bin to PATH in %s (open a new terminal to pick it up)\n' "$rc"
}

# --- host MCP registration ------------------------------------------------------
# Register Beam as a DIRECT HTTP MCP server in the host's own JSON config: no
# proxy, no Node/uv runtime, no PATH dependency, and the key is resolved once
# here rather than at every MCP startup. Atomic write + one-time backup.

mcp_host_json() {
  # $1 = add|remove ; $2 = config path. Key passed via BEAM_REG_KEY (never argv).
  command -v python3 >/dev/null 2>&1 || return 1
  BEAM_REG_ACTION="$1" BEAM_REG_CFG="$2" BEAM_REG_URL="$MCP_URL" python3 - <<'PY'
import json, os, shutil, sys

action = os.environ["BEAM_REG_ACTION"]
cfg = os.environ["BEAM_REG_CFG"]
url = os.environ["BEAM_REG_URL"]
key = os.environ.get("BEAM_REG_KEY", "")

if os.path.exists(cfg):
    try:
        with open(cfg) as fh:
            data = json.load(fh)
    except Exception:
        sys.exit(1)          # never clobber a config we can't parse
    if not isinstance(data, dict):
        sys.exit(1)
elif action == "remove":
    sys.exit(1)
else:
    data = {}

servers = data.get("mcpServers")
if not isinstance(servers, dict):
    servers = {}

if action == "add":
    servers["beam"] = {
        "type": "http",
        "url": url,
        "headers": {"Authorization": "Bearer " + key},
    }
else:
    if "beam" not in servers:
        sys.exit(1)
    del servers["beam"]

data["mcpServers"] = servers

if os.path.exists(cfg):
    backup = cfg + ".beam-backup"
    if not os.path.exists(backup):
        shutil.copy2(cfg, backup)
else:
    parent = os.path.dirname(cfg)
    if parent:
        os.makedirs(parent, exist_ok=True)

tmp = cfg + ".beam-tmp"
with open(tmp, "w") as fh:
    json.dump(data, fh, indent=2)
os.replace(tmp, cfg)
try:
    os.chmod(cfg, 0o600)     # the file now holds an API key
except OSError:
    pass
PY
}

cmd_register() {
  # Register the Beam MCP server WITHOUT the caller handling the key: read it from
  # stored creds and write it into every host config we can find.
  key="$(read_key 2>/dev/null || true)"
  if [ -z "$key" ]; then die "auth_missing" "sign in first: beam login" 3; fi
  hosts=""

  # Claude Code: prefer the official CLI when present (it keeps its own bookkeeping).
  if command -v claude >/dev/null 2>&1; then
    if claude mcp add --transport http beam "$MCP_URL" --header "Authorization: Bearer $key" >/dev/null 2>&1; then
      hosts="claude-code"
    fi
  fi
  # Claude desktop app (and any Claude Code install): the shared ~/.claude.json
  # registry. This is the common case where no `claude` binary exists.
  if [ -z "$hosts" ] && [ -f "$HOME/.claude.json" ]; then
    if BEAM_REG_KEY="$key" mcp_host_json add "$HOME/.claude.json"; then hosts="claude-desktop"; fi
  fi
  if [ -d "$HOME/.cursor" ]; then
    if BEAM_REG_KEY="$key" mcp_host_json add "$HOME/.cursor/mcp.json"; then hosts="$hosts cursor"; fi
  fi
  hosts="${hosts# }"

  if [ -n "$hosts" ]; then
    printf '{"ok":true,"registered":"%s"}\n' "$hosts"
    printf 'Beam connection registered for: %s\n' "$hosts" >&2
    return 0
  fi

  cat >&2 <<EOF
Could not auto-register (no supported host config found, or python3 is missing).
Add a remote HTTP MCP server in your agent:
  name=beam  type=http  url=$MCP_URL  header="Authorization: Bearer <your key>"
Then fully restart your agent.
EOF
  return 2
}

cmd_setup() {
  emit_event install
  # Install + PATH (always).
  bindir="$(cd "$(dirname "$0")" 2>/dev/null && pwd || printf '')"
  mkdir -p "$HOME/.local/bin"
  if [ -n "$bindir" ] && [ "$bindir" != "$HOME/.local/bin" ]; then
    ln -sf "$bindir/beam" "$HOME/.local/bin/beam" 2>/dev/null || cp "$bindir/beam" "$HOME/.local/bin/beam"
    chmod +x "$HOME/.local/bin/beam" 2>/dev/null || true
  fi
  add_to_path_rc >/dev/null 2>&1 || true
  emit_event path_ok

  # Signed in? (verify the stored key actually works)
  key="$(read_key 2>/dev/null || true)"
  signed=0; ws=""
  if [ -n "$key" ] && verify_key "$key" >/dev/null 2>&1; then signed=1; ws="$(read_workspace 2>/dev/null || true)"; fi

  # Register the MCP server where we safely can (needs signed-in + claude CLI).
  registered=0
  if [ "$signed" = "1" ]; then
    if cmd_register >/dev/null 2>&1; then registered=1; emit_event mcp_connected; fi
  fi

  # ---- onboarding output: success line + emoji checklist + last steps ----
  if [ "$signed" = "0" ]; then
    printf '🚀 Beam is installed — 2 quick steps to finish.\n\n'
    printf '  ✅ Plugin installed\n'
    printf '  ✅ beam on your PATH\n'
    printf '  ⬜ Sign in\n'
    printf '  ⬜ Restart your agent\n\n'
    printf 'Next — 3 steps:\n'
    printf '  1. 🔑 Generate a key in Beam  (app.beam.ai -> Personal settings -> API Keys)\n'
    printf '  2. 💻 In your terminal, run:  beam login   (paste the key when asked — it stays hidden as you type)\n'
    printf '  3. 🔄 Restart your agent, then ask "list my Beam agents"\n'
    return 3
  fi

  if [ "$registered" = "1" ]; then printf '🎉 Beam is connected — 1 step left!\n\n'
  else printf '🚀 Almost there — 2 steps left.\n\n'; fi
  printf '  ✅ Plugin installed\n'
  printf '  ✅ beam on your PATH\n'
  if [ -n "$ws" ]; then printf '  ✅ Signed in (workspace %s)\n' "$ws"; else printf '  ✅ Signed in\n'; fi
  if [ -z "$ws" ]; then
    printf '  ⬜ Choose a workspace\n'
  fi
  if [ "$registered" = "1" ]; then
    printf '  ✅ Beam connection registered\n'
    printf '  ⬜ Restart your agent\n\n'
    if [ -z "$ws" ]; then
      printf 'Last steps:\n'
      printf '  1. 🗂  Pick a workspace:  beam workspace list <search>   then  beam workspace <id>\n'
      printf '  2. 🔄 Fully quit and reopen your agent, then ask "list my Beam agents" 🚀\n'
    else
      printf 'Last step: fully quit and reopen your agent, then ask "list my Beam agents" 🚀\n'
    fi
  else
    printf '  ⬜ Register the Beam connection\n'
    printf '  ⬜ Restart your agent\n\n'
    printf 'Last steps:\n'
    printf '  1. Add a remote MCP server in your agent:  name=beam  type=http  url=%s  header="Authorization: Bearer <your key>"\n' "$MCP_URL"
    printf '  2. Fully quit and reopen your agent, then ask "list my Beam agents" 🚀\n'
  fi
}

cmd_uninstall() {
  removed=""
  # Undo the MCP registration we created, rather than leaving it to the user.
  for cfg in "$HOME/.claude.json" "$HOME/.cursor/mcp.json"; do
    if [ -f "$cfg" ] && mcp_host_json remove "$cfg" 2>/dev/null; then removed="$removed $cfg"; fi
  done
  if command -v claude >/dev/null 2>&1; then claude mcp remove beam >/dev/null 2>&1 || true; fi
  if [ -e "$HOME/.local/bin/beam" ]; then rm -f "$HOME/.local/bin/beam"; removed="$removed ~/.local/bin/beam"; fi
  if [ -d "$HOME/.config/beam-plugin/beam" ]; then rm -rf "$HOME/.config/beam-plugin/beam"; removed="$removed ~/.config/beam-plugin/beam"; fi
  printf '{"ok":true,"removed":"%s"}\n' "${removed# }"
  printf 'Credentials kept at %s (run: beam logout to remove).\n' "$CREDS_FILE" >&2
}

main() {
  if [ $# -eq 0 ]; then cmd_help; exit 0; fi
  cmd="$1"; shift
  case "$cmd" in
    -h|--help|help) cmd_help ;;
    --version|version) printf 'beam %s\n' "$VERSION" ;;
    setup) cmd_setup "$@" ;;
    doctor) cmd_doctor "$@" ;;
    login) cmd_login "$@" ;;
    logout) cmd_logout ;;
    whoami) cmd_whoami ;;
    workspace) cmd_workspace "$@" ;;
    agents)
      sub="${1:-}"; shift || true
      case "$sub" in
        list) cmd_agents_list ;;
        get) cmd_agents_get "$@" ;;
        deploy) cmd_agents_deploy "$@" ;;
        publish) cmd_agents_publish "$@" ;;
        delete) cmd_agents_delete "$@" ;;
        *) die "validation_error" "usage: beam agents <list|get|deploy|publish|delete>" 2 ;;
      esac ;;
    agent-builder) cmd_agent_builder "$@" ;;
    mcp) cmd_mcp ;;
    register) cmd_register ;;
    uninstall) cmd_uninstall ;;
    *) die "validation_error" "unknown command: $cmd (try beam --help)" 2 ;;
  esac
}

main "$@"
