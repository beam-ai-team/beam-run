  body="$(read_payload_file "$file")"; require_workspace
  set +e; resp="$(api_write POST "/agent/$agent_id/context/integrations/external-file-url" "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "external file upload result is ambiguous; re-read context files" 5; fi
  printf '%s\n' "$resp"
}

cmd_agents_context_file_delete() {
  agent_id="${1:-}"; file_key="${2:-}"; confirm=""
  if [ -z "$agent_id" ] || [ -z "$file_key" ]; then die "validation_error" "usage: beam agents context-file-delete <agentId> <fileKey> --confirm <fileKey>" 2; fi
  shift 2; while [ $# -gt 0 ]; do case "$1" in --confirm) confirm="${2:-}"; shift 2 ;; *) die "validation_error" "unknown flag for context file deletion: $1" 2 ;; esac; done
  [ "$confirm" = "$file_key" ] || die "confirmation_required" "obtain explicit approval, then repeat the file key with --confirm $file_key" 2
  require_workspace; set +e; resp="$(api_write DELETE "/context/agent/$agent_id/file/$file_key" '')"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "file deletion result is ambiguous; re-read context files" 5; fi
  printf '%s\n' "$resp"
}

