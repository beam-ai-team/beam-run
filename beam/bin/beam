  if [ "$rc" -eq 5 ]; then die "network_error" "external file deletion result is ambiguous; re-read context files" 5; fi
  printf '%s\n' "$resp"
}

cmd_agents_change_file_agent() {
  agent_id="${1:-}"; file="${2:-}"
