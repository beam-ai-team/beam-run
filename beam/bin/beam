#!/bin/sh
# beam — thin agent-oriented CLI for Beam Core.
# Stores credentials under ~/.config/beam/, verifies with /v2/user/me,
# and launches a local stdio MCP proxy to https://api.beamstudio.ai/mcp.
#
# v0.2.0 — activation-v3:
#   - resilient HTTP (timeouts + bounded retries; network vs auth distinguished)
#   - safe credential parsing (no shell-sourcing of the creds file)
#   - no hard python3 dependency (jq -> python3 -> POSIX fallback)
#   - `beam doctor` (human self-diagnosis) and `beam setup` (one-command install)
#   - `beam uninstall`, `beam workspace list`
#   - API key never required on argv (hidden prompt / stdin / env)
#
# v0.4.0 — build & manage agents:
#   - `beam agents get <id>` (inspect one agent)
#   - `beam agents deploy <spec> [--publish] [--dry-run] [--agent-id ID]`
#     (build/update an agent from a spec via the bundled agent-builder graph builder)
#   - `beam agents publish <graphId>` (promote a draft graph — x-api-key)
#   - `beam agents delete <id>` (remove an agent — mints a short-lived Bearer JWT
#     from the API key via /auth/access-token, since the delete route is JWT-gated)
#   - write-capable HTTP layer (_http_send) + api_write / api_bearer helpers
#
# v0.4.1 — activation fixes:
#   - never guess the workspace: with >1 workspace, login leaves it unset and
#     reports the list instead of silently picking workspaces[0]
#   - `beam register` writes the host MCP config itself (Claude desktop, Cursor),
#     instead of printing manual instructions when the `claude` CLI is absent
#   - `beam mcp` uses a vendored stdlib-Python bridge (no npx/uvx needed) and
#     degrades to a live "finish setup" server instead of dying when signed out
#   - `beam doctor` checks what actually breaks: host MCP registration + a real
#     /mcp handshake
#   - `beam uninstall` removes the MCP entries it created
set -eu

VERSION=""
REPO="beam-ai-team/beam-run"
PRODUCTION_API_BASE="https://api.beamstudio.ai"
PRODUCTION_MCP_URL="https://api.beamstudio.ai/mcp"

# A developer shell often exports localhost endpoints for a running Beam stack.
# Plugins inherit that shell environment, so silently honouring those values can
# send a newly installed production CLI to the wrong server. Local development
# remains available, but must be explicit: BEAM_LOCAL_DEV=1.
is_loopback_url() {
  raw="$1"
  [ -n "$raw" ] || return 1
  host="${raw#*://}"
  host="${host%%/*}"
  host="${host##*@}"
  host=$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')
  case "$host" in
    localhost|localhost:*|127.0.0.1|127.0.0.1:*|'[::1]'|'[::1]:'*|::1|::1:*) return 0 ;;
    *) return 1 ;;
  esac
}

resolve_endpoint() {
  candidate="$1"
  fallback="$2"
  if is_loopback_url "$candidate" && [ "${BEAM_LOCAL_DEV:-}" != "1" ]; then
    ignored_loopback_endpoint=1
    resolved_endpoint="$fallback"
  elif [ -n "$candidate" ]; then
    resolved_endpoint="$candidate"
  else
    resolved_endpoint="$fallback"
  fi
}

USER_API_URL="${BEAM_API_URL:-}"
USER_MCP_URL="${BEAM_MCP_URL:-}"
ignored_loopback_endpoint=0
loopback_warning_emitted=0
resolve_endpoint "$USER_API_URL" "$PRODUCTION_API_BASE"
API_BASE="$resolved_endpoint"
resolve_endpoint "$USER_MCP_URL" "$PRODUCTION_MCP_URL"
MCP_URL="$resolved_endpoint"
if [ "${BEAM_CONFIG_DIR:-}" = "$HOME/.config/beam-local" ] && [ "${BEAM_LOCAL_DEV:-}" != "1" ]; then
  CONFIG_DIR="$HOME/.config/beam"
  ignored_loopback_config=1
else
  CONFIG_DIR="${BEAM_CONFIG_DIR:-$HOME/.config/beam}"
  ignored_loopback_config=0
fi
LEGACY_CREDS_FILE="$CONFIG_DIR/credentials"
INSTANCES_DIR="$CONFIG_DIR/instances"
SESSIONS_DIR="$CONFIG_DIR/sessions"
CREDS_FILE="$CONFIG_DIR/no-checkout"
ACTIVE_INSTANCE_ID=""
ACTIVE_INSTANCE_NAME=""

session_id() {
  raw="${BEAM_SESSION_ID:-${CODEX_THREAD_ID:-${CODEX_SESSION_ID:-${CLAUDE_SESSION_ID:-${CURSOR_SESSION_ID:-shell-$PPID}}}}}"
  printf '%s' "$raw" | tr -c 'A-Za-z0-9._-' '_'
}

SESSION_ID="$(session_id)"
SESSION_FILE="$SESSIONS_DIR/$SESSION_ID"
# The stdio bridge needs a REMOTE-streamable-HTTP -> stdio proxy:
#   - uvx: PyPI `mcp-proxy` (sparfenyuk) — proven; args: <url> --transport streamablehttp -H ...
#   - npx: `mcp-remote` (geelen) — the npm equivalent. NOT npm `mcp-proxy`, which is a
#     DIFFERENT tool (stdio -> HTTP server) with incompatible args that silently fails.
# Prefer the DIRECT HTTP MCP registration (type:http) — it needs no proxy at all.

die() {
  # Categorical exit codes agents can branch on:
  # 1 internal, 2 validation, 3 auth, 5 network
  msg=$(printf '%s' "$2" | sed 's/\\/\\\\/g; s/"/\\"/g')
  printf '{"error":{"code":"%s","message":"%s"}}\n' "$1" "$msg" >&2
  exit "$3"
}

warn_if_loopback_was_ignored() {
  [ "$ignored_loopback_endpoint" = "1" ] || [ "$ignored_loopback_config" = "1" ] || return 0
  [ "$loopback_warning_emitted" = "0" ] || return 0
  printf 'Ignoring inherited Beam localhost development settings; using the production API and credentials. Set BEAM_LOCAL_DEV=1 to opt into local development.\n' >&2
  loopback_warning_emitted=1
}
ensure_config_dir() {
  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR" 2>/dev/null || true
}

# --- credentials (parsed, never sourced) ---------------------------------------

file_value() {
  # $1 = file; $2 = key name. Never sources local credential files.
  if [ ! -f "$1" ]; then return 1; fi
  line=$(grep "^$2=" "$1" 2>/dev/null | head -n1) || return 1
  if [ -z "$line" ]; then return 1; fi
  printf '%s' "${line#*=}"
}

creds_value() { file_value "$CREDS_FILE" "$1"; }

profile_file() { printf '%s/%s' "$INSTANCES_DIR" "$1"; }

profile_for_api() {
  wanted="${1%/}"
  for candidate in "$INSTANCES_DIR"/*; do
    [ -f "$candidate" ] || continue
    saved="$(file_value "$candidate" BEAM_API_URL 2>/dev/null || true)"
    [ "${saved%/}" = "$wanted" ] && { printf '%s' "$candidate"; return 0; }
  done
  return 1
}

derive_instance_from_url() {
  # Accept the workspace URL a user knows, or an API URL supplied by automation.
  raw="${1%/}"
  case "$raw" in
    https://*) scheme="https" ;;
    http://*)
      is_loopback_url "$raw" && [ "${BEAM_LOCAL_DEV:-}" = "1" ] || return 2
      scheme="http" ;;
    *) return 2 ;;
  esac
  location="${raw#*://}"
  if [ "${2:-workspace}" = "workspace" ]; then
    case "$location" in */?*) ;; *) return 2 ;; esac
  fi
  authority="${location%%/*}"
  case "$authority" in ""|*@*|*\?*|*\#*) return 2 ;; esac
  host="$(printf '%s' "${authority%%:*}" | tr '[:upper:]' '[:lower:]')"
  [ -n "$host" ] || return 2

  case "$host" in
    app.beam.ai|api.beamstudio.ai)
      DETECTED_INSTANCE_ID="app"
      DETECTED_INSTANCE_NAME="Beam App"
      DETECTED_API_URL="$PRODUCTION_API_BASE" ;;
    app.*.beam.ai)
      region="${host#app.}"; region="${region%.beam.ai}"
      [ -n "$region" ] || return 2
      DETECTED_INSTANCE_ID="$region"
      if [ "$region" = "enterprise" ]; then DETECTED_INSTANCE_NAME="Beam Enterprise"
      else DETECTED_INSTANCE_NAME="Beam $(printf '%s' "$region" | tr '[:lower:]' '[:upper:]')"; fi
      DETECTED_API_URL="https://api.$region.beamstudio.ai" ;;
    enterprise.beamstudio.ai|api.enterprise.beamstudio.ai)
      DETECTED_INSTANCE_ID="enterprise"
      DETECTED_INSTANCE_NAME="Beam Enterprise"
      DETECTED_API_URL="https://api.enterprise.beamstudio.ai" ;;
    api.*.beamstudio.ai)
      region="${host#api.}"; region="${region%.beamstudio.ai}"
      [ -n "$region" ] || return 2
      DETECTED_INSTANCE_ID="$region"
      DETECTED_INSTANCE_NAME="Beam $(printf '%s' "$region" | tr '[:lower:]' '[:upper:]')"
      DETECTED_API_URL="$scheme://$authority" ;;
    *.beamstudio.ai)
      region="${host%.beamstudio.ai}"
      [ -n "$region" ] || return 2
      DETECTED_INSTANCE_ID="$region"
      DETECTED_INSTANCE_NAME="Beam $(printf '%s' "$region" | tr '[:lower:]' '[:upper:]')"
      DETECTED_API_URL="https://api.$region.beamstudio.ai" ;;
    localhost|127.0.0.1|::1)
      [ "${BEAM_LOCAL_DEV:-}" = "1" ] || return 2
      DETECTED_INSTANCE_ID="local"
      DETECTED_INSTANCE_NAME="Beam Local"
      DETECTED_API_URL="$scheme://$authority" ;;
    *)
      # An explicit API URL remains supported for private/custom deployments.
      [ "${2:-workspace}" = "api" ] || return 2
      DETECTED_INSTANCE_ID="$(printf '%s' "$authority" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._-' '-')"
      DETECTED_INSTANCE_NAME="Beam ($host)"
      DETECTED_API_URL="$scheme://$authority" ;;
  esac
  DETECTED_MCP_URL="${DETECTED_API_URL%/}/mcp"
}

profile_count() {
  count=0
  for profile in "$INSTANCES_DIR"/*; do [ -f "$profile" ] && count=$((count + 1)); done
  printf '%s' "$count"
}

only_profile() {
  [ "$(profile_count)" -eq 1 ] || return 1
  for profile in "$INSTANCES_DIR"/*; do [ -f "$profile" ] && { printf '%s' "$profile"; return; }; done
}

write_session() {
  instance="$1"; workspace="${2:-}"; workspace_name="${3:-}"; locked="${4:-0}"
  ensure_config_dir
  mkdir -p "$SESSIONS_DIR"
  chmod 700 "$SESSIONS_DIR" 2>/dev/null || true
  umask 077
  tmp="$SESSION_FILE.tmp.$$"
  {
    printf 'BEAM_INSTANCE_ID=%s\n' "$instance"
    [ -z "$workspace" ] || printf 'BEAM_WORKSPACE_ID=%s\n' "$workspace"
    [ -z "$workspace_name" ] || printf 'BEAM_WORKSPACE_NAME=%s\n' "$workspace_name"
    printf 'BEAM_SESSION_LOCKED=%s\n' "$locked"
  } > "$tmp"
  mv "$tmp" "$SESSION_FILE"
  chmod 600 "$SESSION_FILE"
}

write_profile() {
  instance="$1"; name="$2"; api="$3"; mcp="$4"; key="$5"; workspace="${6:-}"; workspace_name="${7:-}"
  ensure_config_dir
  mkdir -p "$INSTANCES_DIR"
  chmod 700 "$INSTANCES_DIR" 2>/dev/null || true
  target="$(profile_file "$instance")"
  umask 077
  tmp="$target.tmp.$$"
  {
    printf 'BEAM_INSTANCE_ID=%s\n' "$instance"
    printf 'BEAM_INSTANCE_NAME=%s\n' "$name"
    printf 'BEAM_API_URL=%s\n' "$api"
    printf 'BEAM_MCP_URL=%s\n' "$mcp"
    printf 'BEAM_API_KEY=%s\n' "$key"
    [ -z "$workspace" ] || printf 'BEAM_WORKSPACE_ID=%s\n' "$workspace"
    [ -z "$workspace_name" ] || printf 'BEAM_WORKSPACE_NAME=%s\n' "$workspace_name"
  } > "$tmp"
  mv "$tmp" "$target"
  chmod 600 "$target"
}

activate_profile_file() {
  profile="$1"
  [ -f "$profile" ] || return 1
  CREDS_FILE="$profile"
  ACTIVE_INSTANCE_ID="$(file_value "$profile" BEAM_INSTANCE_ID 2>/dev/null || basename "$profile")"
  ACTIVE_INSTANCE_NAME="$(file_value "$profile" BEAM_INSTANCE_NAME 2>/dev/null || printf '%s' "$ACTIVE_INSTANCE_ID")"
  API_BASE="$(file_value "$profile" BEAM_API_URL 2>/dev/null || printf '%s' "$PRODUCTION_API_BASE")"
  MCP_URL="$(file_value "$profile" BEAM_MCP_URL 2>/dev/null || printf '%s/mcp' "${API_BASE%/}")"
}

load_session_context() {
  instance="$(file_value "$SESSION_FILE" BEAM_INSTANCE_ID 2>/dev/null || true)"
  if [ -n "$instance" ]; then
    if activate_profile_file "$(profile_file "$instance")"; then return; fi
    CREDS_FILE="$CONFIG_DIR/no-checkout"
    return
  fi
  profile="$(only_profile 2>/dev/null || true)"
  if [ -n "$profile" ]; then
    activate_profile_file "$profile"
  elif [ "$(profile_count)" -gt 0 ]; then
    # Multiple saved instances require an explicit per-session checkout. Never
    # fall back to the legacy file, which could send work to the wrong instance.
    CREDS_FILE="$CONFIG_DIR/no-checkout"
  fi
}

read_key() {
  if [ -n "$ACTIVE_INSTANCE_ID" ]; then creds_value BEAM_API_KEY; return; fi
  if [ -n "${BEAM_API_KEY:-}" ]; then printf '%s' "$BEAM_API_KEY"; return 0; fi
  creds_value BEAM_API_KEY
}

read_workspace() {
  if [ -n "$ACTIVE_INSTANCE_ID" ]; then
    value="$(file_value "$SESSION_FILE" BEAM_WORKSPACE_ID 2>/dev/null || true)"
    [ -n "$value" ] || return 1
    printf '%s' "$value"
    return 0
  fi
  if [ -n "${BEAM_WORKSPACE_ID:-}" ]; then printf '%s' "$BEAM_WORKSPACE_ID"; return 0; fi
  creds_value BEAM_WORKSPACE_ID
}

write_creds() {
  key="$1"
  workspace="${2:-}"
  if [ -n "$ACTIVE_INSTANCE_ID" ]; then
    workspace_name="$(file_value "$SESSION_FILE" BEAM_WORKSPACE_NAME 2>/dev/null || creds_value BEAM_WORKSPACE_NAME 2>/dev/null || true)"
    write_profile "$ACTIVE_INSTANCE_ID" "$ACTIVE_INSTANCE_NAME" "$API_BASE" "$MCP_URL" "$key" "$workspace" "$workspace_name"
    write_session "$ACTIVE_INSTANCE_ID" "$workspace" "$workspace_name" "$(file_value "$SESSION_FILE" BEAM_SESSION_LOCKED 2>/dev/null || printf '0')"
    return
  fi
}

# --- JSON (jq -> python3 -> POSIX best-effort) ---------------------------------

workspaces_tsv() {
  # reads /v2/user/me JSON on stdin, prints one "id<TAB>name" line per workspace
  if command -v jq >/dev/null 2>&1; then
    jq -r '(.workspaces // [.workspace] // []) | .[]? | select(.id) | "\(.id)\t\(.name // "")"' 2>/dev/null || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    sys.exit(0)
ws=d.get("workspaces") or d.get("workspace") or []
if isinstance(ws, dict):
    ws=[ws]
for w in ws:
    if isinstance(w, dict) and w.get("id"):
        print("%s\t%s" % (w["id"], w.get("name") or ""))' 2>/dev/null || true
  fi
}

resolve_workspace_from_profile() {
  # Resolve the default without guessing. Results are returned in globals:
  # resolved_workspace, resolved_workspace_name, workspace_count, workspace_default_stale.
  # $1 = /v2/user/me response; $2 = preferred workspace; $3 = strict (1 for explicit user input).
  profile_json="$1"
  preferred_workspace="${2:-}"
  strict_preference="${3:-0}"
  workspace_rows="$(printf '%s' "$profile_json" | workspaces_tsv)"
  workspace_count=0
  [ -n "$workspace_rows" ] && workspace_count=$(printf '%s\n' "$workspace_rows" | grep -c .)
  resolved_workspace=""
  resolved_workspace_name=""
  workspace_default_stale=0

  if [ -n "$preferred_workspace" ]; then
    preferred_row="$(printf '%s\n' "$workspace_rows" | awk -F '\t' -v id="$preferred_workspace" '$1 == id { print; exit }')"
    if [ -n "$preferred_row" ]; then
      resolved_workspace="$(printf '%s' "$preferred_row" | cut -f1)"
      resolved_workspace_name="$(printf '%s' "$preferred_row" | cut -f2-)"
      return 0
    fi
    if [ "$strict_preference" = "1" ]; then return 4; fi
    workspace_default_stale=1
  fi

  if [ "$workspace_count" -eq 1 ]; then
    resolved_workspace="$(printf '%s\n' "$workspace_rows" | head -n1 | cut -f1)"
    resolved_workspace_name="$(printf '%s\n' "$workspace_rows" | head -n1 | cut -f2-)"
  fi
  return 0
}

print_workspace_resolution() {
  if [ "$workspace_default_stale" -eq 1 ]; then
    printf 'Previous workspace is no longer available and was cleared.\n' >&2
  fi
  if [ -n "$resolved_workspace" ]; then
    if [ -n "$resolved_workspace_name" ]; then
      printf 'Workspace selected: %s ✅\n' "$resolved_workspace_name" >&2
    else
      printf 'Workspace selected: %s ✅\n' "$resolved_workspace" >&2
    fi
  elif [ "$workspace_count" -gt 1 ]; then
    printf '\nYou have %s available workspaces. Which one would you like to use?\n' "$workspace_count" >&2
    printf 'I can show a short, searchable list if that helps.\n' >&2
  elif [ "$workspace_count" -eq 0 ]; then
    printf '\nNo workspace is available yet. Create or join one in Beam, then run: beam workspace list\n' >&2
  fi
}

can_prompt() { [ -t 0 ] || [ "${BEAM_TEST_INTERACTIVE:-}" = "1" ]; }

create_workspace_for_selection() {
  printf '\nCreate in %s\n' "$ACTIVE_INSTANCE_NAME" >&2
  printf 'Workspace name: ' >&2
  IFS= read -r new_workspace_name || true
  [ -n "$new_workspace_name" ] || die "validation_error" "workspace name cannot be empty" 2
  [ "${#new_workspace_name}" -le 30 ] || die "validation_error" "workspace name must be 30 characters or fewer" 2
  body=$(printf '{"name":%s}' "$(json_quote "$new_workspace_name")")
  selection_key="${LOGIN_KEY:-$(read_key 2>/dev/null || true)}"
  [ -n "$selection_key" ] || die "auth_missing" "no saved key is available for $ACTIVE_INSTANCE_NAME" 3
  if created="$(_http_send POST "$API_BASE/v2/workspace" "$body" -H "x-api-key: $selection_key")"; then :; else
    rc=$?
    [ "$rc" -eq 3 ] && die "workspace_create_forbidden" "the workspace could not be created in $ACTIVE_INSTANCE_NAME; check your permission" 2
    die "network_error" "workspace creation result is unknown; check the instance before retrying" 5
  fi
  SELECTED_WORKSPACE_ID="$(printf '%s' "$created" | extract_workspace_id)"
  [ -n "$SELECTED_WORKSPACE_ID" ] || die "invalid_response" "the workspace was created but Beam did not return its id" 5
  SELECTED_WORKSPACE_NAME="$new_workspace_name"
  printf 'Created %s ✅\n' "$new_workspace_name" >&2
}

select_workspace() {
  # $1 = /v2/user/me response; $2 = optional exact id/name; $3 = previous id.
  workspace_rows="$(printf '%s' "$1" | workspaces_tsv)"
  selector="${2:-}"
  previous="${3:-}"
  workspace_count=0; [ -n "$workspace_rows" ] && workspace_count="$(printf '%s\n' "$workspace_rows" | grep -c .)"
  SELECTED_WORKSPACE_ID=""; SELECTED_WORKSPACE_NAME=""

  if [ -n "$selector" ]; then
    match="$(printf '%s\n' "$workspace_rows" | awk -F '\t' -v q="$selector" 'tolower($1)==tolower(q) || tolower($2)==tolower(q) {print}')"
    match_count=0; [ -n "$match" ] && match_count="$(printf '%s\n' "$match" | grep -c .)"
    [ "$match_count" -eq 1 ] || return 4
    SELECTED_WORKSPACE_ID="$(printf '%s' "$match" | cut -f1)"
    SELECTED_WORKSPACE_NAME="$(printf '%s' "$match" | cut -f2-)"
    return 0
  fi

  if ! can_prompt; then
    [ "$workspace_count" -eq 1 ] || return 6
    SELECTED_WORKSPACE_ID="$(printf '%s' "$workspace_rows" | cut -f1)"
    SELECTED_WORKSPACE_NAME="$(printf '%s' "$workspace_rows" | cut -f2-)"
    return 0
  fi

  printf '\n🚀 Beam session setup\n' >&2
  printf '✅ Instance: %s\n' "$ACTIVE_INSTANCE_NAME" >&2
  printf '⬜ Workspace\n\n' >&2
  printf 'Select a workspace:\n' >&2
  previous_row=""
  if [ -n "$previous" ]; then
    previous_row="$(printf '%s\n' "$workspace_rows" | awk -F '\t' -v q="$previous" '$1 == q {print; exit}')"
  fi
  if [ -n "$previous_row" ]; then
    shown="$(printf '%s\n' "$previous_row"; printf '%s\n' "$workspace_rows" | awk -F '\t' -v q="$previous" '$1 != q' | head -n 24)"
  else
    shown="$(printf '%s\n' "$workspace_rows" | head -n 25)"
  fi
  if [ -n "$shown" ]; then
    printf '%s\n' "$shown" | awk -F '\t' -v q="$previous" '{printf "  %d. %s%s\n", NR, ($2 == "" ? $1 : $2), ($1 == q ? " (previously used)" : "")}' >&2
  fi
  shown_count=0; [ -n "$shown" ] && shown_count="$(printf '%s\n' "$shown" | grep -c .)"
  create_number=$((shown_count + 1))
  printf '  %s. + Create new workspace\n' "$create_number" >&2
  printf 'Enter a number, or type an exact workspace name or ID.\n\n> ' >&2
  IFS= read -r choice || true
  case "$choice" in
    +|new|create|"$create_number") create_workspace_for_selection; return 0 ;;
    *[!0-9]*|"")
      match="$(printf '%s\n' "$workspace_rows" | awk -F '\t' -v q="$choice" 'tolower($1)==tolower(q) || tolower($2)==tolower(q) {print}')"
      [ "$(printf '%s\n' "$match" | grep -c .)" -eq 1 ] || return 4
      selected_row="$match" ;;
    *)
      [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le "$shown_count" ] || return 4
      selected_row="$(printf '%s\n' "$shown" | sed -n "${choice}p")" ;;
  esac
  SELECTED_WORKSPACE_ID="$(printf '%s' "$selected_row" | cut -f1)"
  SELECTED_WORKSPACE_NAME="$(printf '%s' "$selected_row" | cut -f2-)"
}

extract_workspace_id() {
  # reads a workspace or /v2/user/me JSON, prints the workspace id (or empty).
  # Only safe to use when the caller has confirmed there is exactly ONE workspace —
  # guessing across many is how users land in the wrong (often empty) workspace.
  if command -v jq >/dev/null 2>&1; then
    jq -r 'if .id then .id elif .workspaces then (.workspaces[0].id // "") elif .workspace then (.workspace.id // "") else "" end' 2>/dev/null || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    sys.exit(0)
ws=d.get("workspaces") or d.get("workspace") or []
if d.get("id"):
    print(d["id"])
elif isinstance(ws, dict):
    print(ws.get("id") or "")
elif isinstance(ws, list) and ws:
    w=ws[0]
    print(w.get("id") if isinstance(w, dict) else "")' 2>/dev/null || true
  else
    # best-effort: first "id":"..." occurrence (guarded; jq/python3 preferred)
    grep -o '"id"[[:space:]]*:[[:space:]]*"[^"]*"' 2>/dev/null | head -n1 | sed 's/.*"\([^"]*\)"$/\1/' || true
  fi
}

# --- resilient HTTP ------------------------------------------------------------
# Returns: 0 ok (body on stdout) - 3 auth - 5 network/other. Bounded retry+backoff.

_http_get() {
  # $1 = full URL ; remaining args = extra curl args (e.g. -H "Name: value")
  url="$1"; shift
  tmp=$(mktemp 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}/beam.$$")
  attempt=1; max=3; delay=1
  while [ "$attempt" -le "$max" ]; do
    # Capture curl's status via an `if` so errexit stays untouched: toggling
    # `set +e`/`set -e` in here silently re-enabled it for the CALLER, which made
    # `beam doctor` abort mid-checklist on a rejected key (the one case it exists for).
    # Ask for a compressed response.  /v2/user/me can include thousands of
    # workspaces; without this, a valid key can look rejected when the large
    # uncompressed profile cannot finish inside the timeout.
    if code=$(curl -sS --compressed --connect-timeout 5 --max-time 30 -o "$tmp" -w '%{http_code}' "$@" "$url" 2>/dev/null); then
      cx=0
    else
      cx=$?
    fi
    if [ "$cx" -ne 0 ]; then
      if [ "$attempt" -lt "$max" ]; then sleep "$delay"; delay=$((delay * 2)); attempt=$((attempt + 1)); continue; fi
      rm -f "$tmp"; return 5
    fi
    case "$code" in
      2*) cat "$tmp"; rm -f "$tmp"; return 0 ;;
      401|403) rm -f "$tmp"; return 3 ;;
      404) cat "$tmp"; rm -f "$tmp"; return 4 ;;
      5*) if [ "$attempt" -lt "$max" ]; then sleep "$delay"; delay=$((delay * 2)); attempt=$((attempt + 1)); continue; fi
          rm -f "$tmp"; return 5 ;;
      *) rm -f "$tmp"; return 5 ;;
    esac
  done
  rm -f "$tmp"; return 5
}

json_collection_empty() {
  if command -v jq >/dev/null 2>&1; then
    jq -e 'if type == "array" then length == 0 else ((.agents // .data // .items // []) | length == 0) end' >/dev/null 2>&1
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys
try:
    data=json.load(sys.stdin)
    values=data if isinstance(data,list) else data.get("agents",data.get("data",data.get("items",[])))
    sys.exit(0 if isinstance(values,list) and len(values)==0 else 1)
except Exception:
    sys.exit(1)' 2>/dev/null
  elif command -v node >/dev/null 2>&1; then
    node -e 'let s="";process.stdin.on("data",d=>s+=d);process.stdin.on("end",()=>{try{const d=JSON.parse(s);const v=Array.isArray(d)?d:(d.agents??d.data??d.items??[]);process.exit(Array.isArray(v)&&v.length===0?0:1)}catch{process.exit(1)}})' 2>/dev/null
  else
    return 1
  fi
}

verify_key() {
  # $1 = key to test; prints /v2/user/me body on success
  warn_if_loopback_was_ignored
  _http_get "$API_BASE/v2/user/me" -H "x-api-key: $1"
}

detect_key_instance() {
  key="$1"; instance_url="$2"; url_kind="${3:-workspace}"
  warn_if_loopback_was_ignored
  DETECTED_INSTANCE_ID=""; DETECTED_INSTANCE_NAME=""; DETECTED_API_URL=""; DETECTED_MCP_URL=""; DETECTED_PROFILE=""
  derive_instance_from_url "$instance_url" "$url_kind" || return 2
  if DETECTED_PROFILE="$(_http_get "$DETECTED_API_URL/v2/user/me" -H "x-api-key: $key")"; then return 0; else return $?; fi
}

api_request() {
  # $1 = path; uses stored/env key + workspace
  warn_if_loopback_was_ignored
  path="$1"
  key="$(read_key)" || return 3
  ws="$(read_workspace 2>/dev/null || true)"
  if [ -n "$ws" ]; then
    _http_get "$API_BASE$path" -H "x-api-key: $key" -H "current-workspace-id: $ws"
  else
    _http_get "$API_BASE$path" -H "x-api-key: $key"
  fi
}

trace_read_transport() {
  # Opt-in diagnostic record for a supervisor handoff. It is intentionally sent
  # to stderr so every established JSON response remains byte-for-byte usable.
  [ "${BEAM_TRACE_TRANSPORT:-0}" = "1" ] || return 0
  printf '{"beamTransport":{"operation":"read","path":"%s","auth":"%s"}}\n' "$1" "$2" >&2
}

api_bearer_read() {
  # $1 = path. Some workspace read endpoints reject x-api-key but accept the
  # short-lived Bearer token minted from that same key. Keep this GET-only.
  path="$1"
  tok="$(mint_bearer)" || return 3
  ws="$(read_workspace 2>/dev/null || true)"
  if [ -n "$ws" ]; then
    _http_get "$API_BASE$path" -H "Authorization: Bearer $tok" -H "current-workspace-id: $ws"
  else
    _http_get "$API_BASE$path" -H "Authorization: Bearer $tok"
  fi
}

api_read() {
  # $1 = path. Preserve the established API-key transport first. A second GET
  # with a minted Bearer token is safe only after the first response is 401/403.
  # Never use this helper for a write: writes must not be replayed.
  path="$1"
  if resp="$(api_request "$path")"; then
    trace_read_transport "$path" "api-key"
    printf '%s' "$resp"
    return 0
  else
    rc=$?
  fi
  [ "$rc" -eq 3 ] || return "$rc"
  if resp="$(api_bearer_read "$path")"; then
    trace_read_transport "$path" "bearer-fallback"
    printf '%s' "$resp"
    return 0
  else
    return $?
  fi
}

# --- write-capable HTTP (POST/PUT/PATCH/DELETE) --------------------------------
# Like _http_get but sends a method (+ optional JSON body). SINGLE attempt: a write
# is not blindly retried (a 5xx may already have applied). Returns 0 ok (body on
# stdout), 3 auth, 5 network/other.
_http_send() {
  # $1 = method ; $2 = full URL ; $3 = body ('' for none) ; rest = extra curl args
  method="$1"; url="$2"; body="$3"; shift 3
  tmp=$(mktemp 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}/beam.$$")
  # As in _http_get: never toggle errexit here — it leaks to the caller.
  if [ -n "$body" ]; then
    if code=$(printf '%s' "$body" | curl -sS --compressed --connect-timeout 5 --max-time 60 \
      -X "$method" -H "Content-Type: application/json" --data-binary @- \
      -o "$tmp" -w '%{http_code}' "$@" "$url" 2>/dev/null); then cx=0; else cx=$?; fi
  else
    if code=$(curl -sS --compressed --connect-timeout 5 --max-time 60 \
      -X "$method" -o "$tmp" -w '%{http_code}' "$@" "$url" 2>/dev/null); then cx=0; else cx=$?; fi
  fi
  if [ "$cx" -ne 0 ]; then rm -f "$tmp"; return 5; fi
  case "$code" in
    2*) cat "$tmp"; rm -f "$tmp"; return 0 ;;
    401|403) rm -f "$tmp"; return 3 ;;
    *) rm -f "$tmp"; return 5 ;;
  esac
}

api_write() {
  # $1 = method ; $2 = path ; $3 = body ('' for none). x-api-key + workspace.
  # The /agent-graphs/* routes (create, update, publish) accept the API key.
  warn_if_loopback_was_ignored
  method="$1"; path="$2"; body="${3:-}"
  key="$(read_key)" || return 3
  ws="$(read_workspace 2>/dev/null || true)"
  if [ -n "$ws" ]; then
    _http_send "$method" "$API_BASE$path" "$body" -H "x-api-key: $key" -H "current-workspace-id: $ws"
  else
    _http_send "$method" "$API_BASE$path" "$body" -H "x-api-key: $key"
  fi
}

api_unscoped_write() {
  # $1 = method ; $2 = path ; $3 = body ('' for none). Workspace creation is
  # account-scoped, so it must not inherit the caller's current-workspace-id.
  warn_if_loopback_was_ignored
  method="$1"; path="$2"; body="${3:-}"
  key="$(read_key)" || return 3
  _http_send "$method" "$API_BASE$path" "$body" -H "x-api-key: $key"
}

api_upload() {
  # $1 path, $2 multipart field name, $3 local file. Single attempt: uploads are writes.
  warn_if_loopback_was_ignored
  path="$1"; field="$2"; file="$3"
  key="$(read_key)" || return 3
  ws="$(read_workspace 2>/dev/null || true)"
  tmp="$(mktemp 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}/beam.$$")"
  mime="$(file -b --mime-type "$file" 2>/dev/null || printf 'application/octet-stream')"
  if [ -n "$ws" ]; then
    if code="$(curl -sS --compressed --connect-timeout 5 --max-time 120 -X POST \
      -H "x-api-key: $key" -H "current-workspace-id: $ws" \
      -F "$field=@$file;type=$mime" -o "$tmp" -w '%{http_code}' "$API_BASE$path" 2>/dev/null)"; then cx=0; else cx=$?; fi
  else
    if code="$(curl -sS --compressed --connect-timeout 5 --max-time 120 -X POST \
      -H "x-api-key: $key" -F "$field=@$file;type=$mime" \
      -o "$tmp" -w '%{http_code}' "$API_BASE$path" 2>/dev/null)"; then cx=0; else cx=$?; fi
  fi
  if [ "$cx" -ne 0 ]; then rm -f "$tmp"; return 5; fi
  case "$code" in 2*) cat "$tmp"; rm -f "$tmp"; return 0 ;; 401|403) rm -f "$tmp"; return 3 ;; *) rm -f "$tmp"; return 5 ;; esac
}

extract_id_token() {
  # reads /auth/access-token JSON on stdin, prints the idToken (or empty)
  if command -v jq >/dev/null 2>&1; then
    jq -r '.idToken // .accessToken // .token // ""' 2>/dev/null || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys
try:
    d=json.load(sys.stdin)
except Exception:
    sys.exit(0)
print(d.get("idToken") or d.get("accessToken") or d.get("token") or "")' 2>/dev/null || true
  else
    grep -o '"idToken"[[:space:]]*:[[:space:]]*"[^"]*"' 2>/dev/null | head -n1 | sed 's/.*"\([^"]*\)"$/\1/' || true
  fi
}

mint_bearer() {
  # Exchange the stored API key for a short-lived Bearer JWT (idToken). Some routes
  # (agent delete, triggers, webhooks) are JWT-gated and reject the raw API key.
  warn_if_loopback_was_ignored
  key="$(read_key)" || return 3
  set +e
  resp="$(_http_send POST "$API_BASE/auth/access-token" "{\"apiKey\":\"$key\"}")"
  rc=$?
  set -e
  [ "$rc" -eq 0 ] || return "$rc"
  tok="$(printf '%s' "$resp" | extract_id_token)"
  [ -n "$tok" ] || return 3
  printf '%s' "$tok"
}

api_bearer() {
  # $1 = method ; $2 = path ; $3 = body ('' for none). Uses a minted Bearer JWT.
  method="$1"; path="$2"; body="${3:-}"
  tok="$(mint_bearer)" || return 3
  ws="$(read_workspace 2>/dev/null || true)"
  if [ -n "$ws" ]; then
    _http_send "$method" "$API_BASE$path" "$body" -H "Authorization: Bearer $tok" -H "current-workspace-id: $ws"
  else
    _http_send "$method" "$API_BASE$path" "$body" -H "Authorization: Bearer $tok"
  fi
}

# Resolve the real directory of this script, following one symlink level
# (~/.local/bin/beam is a symlink into the plugin). Used to locate bundled skills.
script_dir() {
  src="$0"
  if [ -L "$src" ]; then
    target="$(readlink "$src" 2>/dev/null || true)"
    case "$target" in
      /*) src="$target" ;;
      *) src="$(dirname "$src")/$target" ;;
    esac
  fi
  (cd "$(dirname "$src")" 2>/dev/null && pwd) || printf '%s' "$(dirname "$0")"
}

# The plugin manifests and CLI share this release version. `script_dir` follows
# the common ~/.local/bin/beam symlink so the launcher reads its bundled file.
VERSION_FILE="$(script_dir)/../VERSION"
[ -r "$VERSION_FILE" ] || die "internal_error" "version file not found ($VERSION_FILE) — reinstall the plugin" 1
VERSION="$(tr -d '[:space:]' < "$VERSION_FILE")"
[ -n "$VERSION" ] || die "internal_error" "version file is empty ($VERSION_FILE) — reinstall the plugin" 1

# --- telemetry (local placeholder until a sink is chosen — SPEC-00) ------------

emit_event() {
  if [ "${BEAM_TELEMETRY:-1}" = "0" ]; then return 0; fi
  ensure_config_dir
  if [ ! -f "$CONFIG_DIR/install_id" ]; then
    { command -v uuidgen >/dev/null 2>&1 && uuidgen || date +%s; } > "$CONFIG_DIR/install_id" 2>/dev/null || true
  fi
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || printf 'now')
  printf '%s stage=%s host=%s os=%s ver=%s\n' "$ts" "$1" "${BEAM_HOST:-unknown}" \
    "$(uname -s 2>/dev/null || printf unknown)" "$VERSION" >> "$CONFIG_DIR/events.log" 2>/dev/null || true
}

# --- commands ------------------------------------------------------------------

require_instance_checkout() {
  if [ -z "${BEAM_API_KEY:-}" ] && [ -z "$ACTIVE_INSTANCE_ID" ] && [ -f "$SESSION_FILE" ] && [ "$(profile_count)" -gt 0 ]; then
    die "checkout_unavailable" "this session's saved Beam instance is no longer connected. Start a new session and run: beam checkout <instance> [workspace]" 2
  fi
  if [ -z "${BEAM_API_KEY:-}" ] && [ "$(profile_count)" -gt 1 ] && [ -z "$ACTIVE_INSTANCE_ID" ]; then
    die "checkout_required" "this session has no Beam checkout. Run: beam instance list, then beam checkout <instance> [workspace]" 2
  fi
}

lock_session_context() {
  [ -n "$ACTIVE_INSTANCE_ID" ] || return 0
  [ -f "$SESSION_FILE" ] || return 0
  [ "$(file_value "$SESSION_FILE" BEAM_SESSION_LOCKED 2>/dev/null || printf '0')" = "1" ] && return 0
  write_session "$ACTIVE_INSTANCE_ID" \
    "$(file_value "$SESSION_FILE" BEAM_WORKSPACE_ID 2>/dev/null || true)" \
    "$(file_value "$SESSION_FILE" BEAM_WORKSPACE_NAME 2>/dev/null || true)" 1
}

prepare_scoped_session() {
  require_instance_checkout
  lock_session_context
  if [ -n "$ACTIVE_INSTANCE_ID" ]; then
    workspace_name="$(file_value "$SESSION_FILE" BEAM_WORKSPACE_NAME 2>/dev/null || true)"
    workspace_id="$(read_workspace 2>/dev/null || true)"
    printf 'Beam context: %s / %s\n' "$ACTIVE_INSTANCE_NAME" "${workspace_name:-${workspace_id:-not selected}}" >&2
  fi
}

instance_profile_for() {
  selector="$1"
  matches=""
  for candidate in "$INSTANCES_DIR"/*; do
    [ -f "$candidate" ] || continue
    id="$(file_value "$candidate" BEAM_INSTANCE_ID 2>/dev/null || basename "$candidate")"
    name="$(file_value "$candidate" BEAM_INSTANCE_NAME 2>/dev/null || printf '%s' "$id")"
    if [ "$selector" = "$id" ] || [ "$(printf '%s' "$selector" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" ]; then
      [ -z "$matches" ] || return 2
      matches="$candidate"
    fi
  done
  [ -n "$matches" ] || return 1
  printf '%s' "$matches"
}

choose_instance_for_session() {
  profiles=""
  for candidate in "$INSTANCES_DIR"/*; do [ -f "$candidate" ] && profiles="${profiles}${profiles:+
}$candidate"; done
  count=0; [ -n "$profiles" ] && count="$(printf '%s\n' "$profiles" | grep -c .)"
  [ "$count" -gt 0 ] || return 3
  if [ "$count" -eq 1 ]; then CHOSEN_PROFILE="$profiles"; return 0; fi
  can_prompt || return 6

  printf '\n🚀 Beam session setup\n' >&2
  printf '⬜ Instance\n' >&2
  printf '⬜ Workspace\n\n' >&2
  printf 'Select an instance:\n' >&2
  number=0
  while IFS= read -r candidate; do
    number=$((number + 1))
    name="$(file_value "$candidate" BEAM_INSTANCE_NAME 2>/dev/null || basename "$candidate")"
    printf '  %s. %s\n' "$number" "$name" >&2
  done <<EOF
$profiles
EOF
  add_number=$((count + 1))
  printf '  %s. + Add new instance\n\n> ' "$add_number" >&2
  IFS= read -r choice || true
  case "$choice" in
    +|new|add|"$add_number") return 7 ;;
    *[!0-9]*|"") return 4 ;;
    *)
      [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le "$count" ] || return 4
      CHOSEN_PROFILE="$(printf '%s\n' "$profiles" | sed -n "${choice}p")" ;;
  esac
}

cmd_instance() {
  [ "${1:-list}" = "list" ] || die "validation_error" "usage: beam instance list" 2
  count="$(profile_count)"
  if [ "$count" -eq 0 ]; then die "auth_missing" "no Beam instances are connected — run: beam login" 3; fi
  printf '🚀 Beam session setup\n' >&2
  printf '⬜ Instance\n' >&2
  printf '⬜ Workspace\n\n' >&2
  printf 'Connected instances:\n' >&2
  number=0
  for profile in "$INSTANCES_DIR"/*; do
    [ -f "$profile" ] || continue
    number=$((number + 1))
    id="$(file_value "$profile" BEAM_INSTANCE_ID 2>/dev/null || basename "$profile")"
    name="$(file_value "$profile" BEAM_INSTANCE_NAME 2>/dev/null || printf '%s' "$id")"
    printf '%s. %s\n' "$number" "$name" >&2
  done
  printf '%s. + Add another\n\n' "$((number + 1))" >&2
  printf 'Choose for this session: beam checkout <instance-name>\n' >&2
  printf 'Add another: beam login\n' >&2
}

cmd_checkout() {
  selector="${1:-}"; workspace_selector="${2:-}"
  [ $# -le 2 ] || die "validation_error" "usage: beam checkout <instance> [workspace]" 2
  if [ -z "$selector" ]; then
    if [ -n "$ACTIVE_INSTANCE_ID" ] && read_workspace >/dev/null 2>&1; then
      ws="$(read_workspace 2>/dev/null || true)"
      ws_name="$(file_value "$SESSION_FILE" BEAM_WORKSPACE_NAME 2>/dev/null || true)"
      locked="$(file_value "$SESSION_FILE" BEAM_SESSION_LOCKED 2>/dev/null || printf '0')"
      printf '{"instanceId":"%s","instanceName":"%s","workspaceId":%s,"workspaceName":%s,"locked":%s}\n' \
        "$ACTIVE_INSTANCE_ID" "$ACTIVE_INSTANCE_NAME" \
        "$(if [ -n "$ws" ]; then json_quote "$ws"; else printf null; fi)" \
        "$(if [ -n "$ws_name" ]; then json_quote "$ws_name"; else printf null; fi)" "$locked"
      return 0
    fi
    if [ -n "$ACTIVE_INSTANCE_ID" ]; then
      selector="$ACTIVE_INSTANCE_ID"
    else
      if choose_instance_for_session; then choose_rc=0; else choose_rc=$?; fi
      case "$choose_rc" in
        0) selector="$(file_value "$CHOSEN_PROFILE" BEAM_INSTANCE_ID 2>/dev/null || basename "$CHOSEN_PROFILE")" ;;
        3)
          can_prompt && { cmd_login; return; }
          printf '🚀 Beam session setup\n' >&2
          printf '✅ Beam Run ready\n' >&2
          printf '⬜ Connect Beam\n\n' >&2
          printf 'Next: run beam login, then:\n' >&2
          printf '1. Paste a Beam workspace URL\n' >&2
          printf '2. Enter the API key in the hidden prompt\n' >&2
          printf '3. Select or create a workspace\n' >&2
          die "auth_missing" "Beam connection is required before work can begin" 3 ;;
        7) cmd_login; return ;;
        6) cmd_instance list; return 2 ;;
        *) die "instance_required" "choose one of the listed Beam instances" 2 ;;
      esac
    fi
  fi

  if profile="$(instance_profile_for "$selector")"; then :
  else
    rc=$?
    [ "$rc" -eq 2 ] && die "instance_ambiguous" "more than one saved instance matches '$selector'" 2
    die "instance_not_found" "no saved Beam instance matches '$selector'. Run: beam instance list" 2
  fi
  target_id="$(file_value "$profile" BEAM_INSTANCE_ID 2>/dev/null || basename "$profile")"
  previous_workspace="$(file_value "$profile" BEAM_WORKSPACE_ID 2>/dev/null || true)"
  current_ws="$(file_value "$SESSION_FILE" BEAM_WORKSPACE_ID 2>/dev/null || true)"
  session_locked="$(file_value "$SESSION_FILE" BEAM_SESSION_LOCKED 2>/dev/null || printf '0')"
  if [ "$session_locked" = "1" ]; then
    current_name="$(file_value "$SESSION_FILE" BEAM_WORKSPACE_NAME 2>/dev/null || true)"
    [ "$target_id" = "$ACTIVE_INSTANCE_ID" ] || die "session_locked" "this session is locked to its current Beam instance. Start a new session to use another instance." 2
    if [ -n "$current_ws" ] && \
       { [ -z "$workspace_selector" ] || [ "$workspace_selector" = "$current_ws" ] || [ "$(printf '%s' "$workspace_selector" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$current_name" | tr '[:upper:]' '[:lower:]')" ]; }; then
      cmd_checkout
      return 0
    fi
    [ -z "$current_ws" ] || die "session_locked" "this session is locked to its current Beam workspace. Start a new session to use another workspace." 2
  fi

  activate_profile_file "$profile"
  key="$(read_key)" || die "auth_missing" "the saved key for $ACTIVE_INSTANCE_NAME is missing — run: beam login --replace" 3
  if user_profile="$(verify_key "$key")"; then :; else
    rc=$?; [ "$rc" -eq 3 ] && die "auth_invalid" "the saved key for $ACTIVE_INSTANCE_NAME was rejected — run: beam login --replace" 3
    die "network_error" "could not reach $ACTIVE_INSTANCE_NAME; this session was not changed" 5
  fi

  if select_workspace "$user_profile" "$workspace_selector" "$previous_workspace"; then select_rc=0; else select_rc=$?; fi
  if [ "$select_rc" -eq 4 ]; then die "workspace_not_found" "choose one workspace available in $ACTIVE_INSTANCE_NAME" 2; fi
  if [ "$select_rc" -eq 6 ]; then
    rows="$(printf '%s' "$user_profile" | workspaces_tsv)"
    previous_row=""
    if [ -n "$previous_workspace" ]; then
      previous_row="$(printf '%s\n' "$rows" | awk -F '\t' -v q="$previous_workspace" '$1 == q {print; exit}')"
    fi
    printf '🚀 Beam session setup\n' >&2
    printf '✅ Instance: %s\n' "$ACTIVE_INSTANCE_NAME" >&2
    printf '⬜ Workspace\n\n' >&2
    if [ -n "$previous_row" ]; then
      previous_name="$(printf '%s' "$previous_row" | cut -f2-)"
      printf 'Previously used: %s\n' "${previous_name:-$previous_workspace}" >&2
      printf 'Run beam checkout again with that workspace name to confirm it.\n' >&2
    else
      printf 'Choose a workspace by exact name, or create a new one.\n' >&2
      printf 'Select: beam checkout %s <workspace-name>\n' "$ACTIVE_INSTANCE_ID" >&2
      printf 'Create: beam workspace create <name>, then select it with beam checkout\n' >&2
    fi
    die "workspace_required" "workspace selection is required before Beam work can begin" 2
  fi
  workspace="$SELECTED_WORKSPACE_ID"; workspace_name="$SELECTED_WORKSPACE_NAME"

  write_profile "$ACTIVE_INSTANCE_ID" "$ACTIVE_INSTANCE_NAME" "$API_BASE" "$MCP_URL" "$key" "$workspace" "$workspace_name"
  write_session "$ACTIVE_INSTANCE_ID" "$workspace" "$workspace_name" 1
  printf '{"ok":true,"instanceId":"%s","instanceName":"%s","workspaceId":"%s","workspaceName":%s,"locked":%s}\n' \
    "$ACTIVE_INSTANCE_ID" "$ACTIVE_INSTANCE_NAME" "$workspace" "$(if [ -n "$workspace_name" ]; then json_quote "$workspace_name"; else printf null; fi)" \
    true
  printf 'Checked out %s / %s for this session ✅\n' "$ACTIVE_INSTANCE_NAME" "${workspace_name:-$workspace}" >&2
  printf 'This session is locked to this instance and workspace.\n' >&2
}

cmd_help() {
  cat <<EOF
beam $VERSION — Beam Core CLI for coding agents

Usage:
  beam setup                 guided install: PATH + auth + MCP registration
  beam register              register the Beam MCP server with your agent
  beam doctor                self-diagnose install/auth/connection (human checklist)
  beam login                 connect from a workspace URL, then select a workspace
  beam login --replace       replace the key for that workspace URL's instance
  beam logout
  beam instance list         show saved Beam instances and the add-new option
  beam checkout <instance> [workspace]
                             choose one instance + workspace for this session
  beam whoami [--raw]          compact identity summary (use --raw only when needed)
  beam workspace [ID]        show/set current workspace
  beam workspace list [q]    list/search your workspaces (filter by name or id)
  beam workspace create <name> [--domain domain] [--icon-src url]
                              create a workspace; it does not change the current workspace
  beam agents list           list agents in the current workspace
  beam agents get <id>       inspect one agent
  beam agents deploy <spec>  build/update an agent from a spec (draft; --publish to go live)
  beam agents publish <gid>  publish a draft graph (graphId from deploy output)
  beam agents delete <id> --confirm <id>
                              delete an agent (irreversible; requires exact confirmation)
  beam tasks test <id> <q>   run a task against the agent's draft graph
  beam tasks list [flags]    list/search workspace tasks
  beam tasks create <id> <q> [--draft]
                             run a live task (or a draft test with --draft)
  beam tasks get <id>        inspect a task or draft test task
  beam tasks retry <id> [--task-node-id ID --feedback text]
  beam tasks approve <taskId> <taskNodeId> --confirm <taskNodeId>
  beam tasks reject <taskId> <taskNodeId> --confirm <taskNodeId> [--reason text]
  beam tasks abort <id> --confirm <id> [--reason text]
  beam tasks delete <id> --confirm <id>
  beam tasks rate <id> <up|down> [feedback]
  beam tasks submit-input <taskId> <taskNodeId> <parameter> <answer>
                             provide a requested value to a paused task
  beam inbox <cmd>           list/read/delete notifications
  beam integrations <cmd>    inspect and manage workspace connections
  beam templates <cmd>       browse templates and create draft agents
  beam analytics <cmd>       inspect or export agent analytics
  beam views <cmd>           inspect records or export a saved view
  beam learning <cmd>        inspect issues, feedback, jobs, and optimization
  beam agent-builder <cmd>   bundled agent builder (design/build/patch graphs)
  beam mcp check [--tool n]  verify MCP auth and optionally a tool's availability
  beam mcp                   local session-aware MCP bridge
  beam uninstall
  beam --version | --help

Auth:
  beam login                   # workspace URL + masked key prompts (recommended)
  BEAM_WORKSPACE_URL=... BEAM_API_KEY=... beam login
  printf '%s' "\$KEY" | beam login --url "\$WORKSPACE_URL" --api-key -

Docs: https://github.com/$REPO
EOF
}

cmd_login() {
  load_session_context
  key=""; workspace=""; workspace_url="${BEAM_WORKSPACE_URL:-}"; url_kind="workspace"; replace=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --api-key) key="${2:-}"; shift 2 ;;
      --workspace-id) workspace="${2:-}"; shift 2 ;;
      --workspace-url|--url) workspace_url="${2:-}"; url_kind="workspace"; shift 2 ;;
      --api-url) workspace_url="${2:-}"; url_kind="api"; shift 2 ;;
      --replace) replace=1; shift ;;
      --paste) shift ;;
      -h|--help) cmd_help; exit 0 ;;
      *) die "validation_error" "unknown flag: $1 (try beam login --help)" 2 ;;
    esac
  done

  if [ -z "$workspace_url" ] && [ "$replace" -eq 1 ] && [ -n "$ACTIVE_INSTANCE_ID" ]; then
    workspace_url="$API_BASE"; url_kind="api"
  fi
  if [ -z "$workspace_url" ]; then
    if can_prompt; then
      printf 'Paste your Beam workspace URL: ' >&2
      IFS= read -r workspace_url || true
    else
      die "workspace_url_missing" "no workspace URL — use BEAM_WORKSPACE_URL=https://… with beam login; the API key must be supplied securely through BEAM_API_KEY or --api-key -" 3
    fi
  fi
  [ -n "$workspace_url" ] || die "workspace_url_missing" "workspace URL cannot be empty" 2
  derive_instance_from_url "$workspace_url" "$url_kind" || die "workspace_url_invalid" "use a Beam workspace URL such as https://app.us.beam.ai/<workspace>" 2
  existing_profile="$(profile_for_api "$DETECTED_API_URL" 2>/dev/null || true)"
  if [ -n "$existing_profile" ] && [ "$replace" -ne 1 ]; then
    die "instance_exists" "$DETECTED_INSTANCE_NAME is already connected. Nothing changed. Use beam login --replace to update its saved key." 2
  fi
  if [ -z "$existing_profile" ] && [ "$replace" -eq 1 ]; then
    die "instance_not_found" "$DETECTED_INSTANCE_NAME is not connected, so there is no saved key to replace. Run beam login to add it." 2
  fi

  if [ "$key" = "-" ]; then IFS= read -r key || true; fi
  if [ -z "$key" ] && [ -n "${BEAM_API_KEY:-}" ]; then key="$BEAM_API_KEY"; fi
  if [ -z "$key" ]; then
    if can_prompt; then
      printf 'Add your Beam API key (it stays hidden as you type): ' >&2
      if [ -t 0 ] && command -v stty >/dev/null 2>&1; then
        stty -echo 2>/dev/null || true; IFS= read -r key || true; stty echo 2>/dev/null || true; printf '\n' >&2
      else
        IFS= read -r key || true
      fi
    else
      die "auth_missing" "no key — run beam login in a terminal, use BEAM_API_KEY=... beam login, or pipe to --api-key -. Avoid --api-key <key> (leaks to history)." 3
    fi
  fi
  if [ -z "$key" ]; then die "auth_missing" "empty API key" 3; fi

  set +e; detect_key_instance "$key" "$workspace_url" "$url_kind"; vc=$?; set -e
  if [ "$vc" -eq 2 ]; then die "workspace_url_invalid" "the Beam instance could not be resolved from that workspace URL" 2; fi
  if [ "$vc" -eq 3 ]; then die "auth_invalid" "the API key was rejected by $DETECTED_INSTANCE_NAME — nothing was saved" 3; fi
  if [ "$vc" -eq 5 ]; then die "network_error" "could not reach $DETECTED_INSTANCE_NAME — nothing was saved" 5; fi

  if [ -n "$existing_profile" ]; then
    DETECTED_INSTANCE_ID="$(file_value "$existing_profile" BEAM_INSTANCE_ID 2>/dev/null || basename "$existing_profile")"
  fi
  target_profile="${existing_profile:-$(profile_file "$DETECTED_INSTANCE_ID")}"
  resp="$DETECTED_PROFILE"

  LOGIN_KEY="$key"
  API_BASE="$DETECTED_API_URL"; MCP_URL="$DETECTED_MCP_URL"
  ACTIVE_INSTANCE_ID="$DETECTED_INSTANCE_ID"; ACTIVE_INSTANCE_NAME="$DETECTED_INSTANCE_NAME"
  current_locked="$(file_value "$SESSION_FILE" BEAM_SESSION_LOCKED 2>/dev/null || printf '0')"
  current_instance="$(file_value "$SESSION_FILE" BEAM_INSTANCE_ID 2>/dev/null || true)"
  selection_request="${workspace:-${BEAM_WORKSPACE_ID:-}}"
  if [ "$current_locked" = "1" ] && [ "$current_instance" = "$DETECTED_INSTANCE_ID" ]; then
    selection_request="$(file_value "$SESSION_FILE" BEAM_WORKSPACE_ID 2>/dev/null || true)"
  fi
  if select_workspace "$resp" "$selection_request"; then select_rc=0; else select_rc=$?; fi
  if [ "$select_rc" -eq 4 ]; then die "workspace_not_found" "choose one workspace available in $DETECTED_INSTANCE_NAME" 2; fi
  if [ "$select_rc" -eq 6 ]; then
    SELECTED_WORKSPACE_ID=""; SELECTED_WORKSPACE_NAME=""
  fi
  unset LOGIN_KEY

  write_profile "$DETECTED_INSTANCE_ID" "$DETECTED_INSTANCE_NAME" "$DETECTED_API_URL" "$DETECTED_MCP_URL" "$key" "$SELECTED_WORKSPACE_ID" "$SELECTED_WORKSPACE_NAME"
  if [ "$current_locked" != "1" ] || [ "$current_instance" = "$DETECTED_INSTANCE_ID" ]; then
    write_session "$DETECTED_INSTANCE_ID" "$SELECTED_WORKSPACE_ID" "$SELECTED_WORKSPACE_NAME" "$(if [ -n "$SELECTED_WORKSPACE_ID" ]; then printf 1; else printf 0; fi)"
    activate_profile_file "$target_profile"
  fi
  emit_event auth_ok
  printf '{"ok":true,"instanceId":"%s","instanceName":"%s","workspaceId":%s,"workspaceCount":%s}\n' \
    "$DETECTED_INSTANCE_ID" "$DETECTED_INSTANCE_NAME" \
    "$(if [ -n "$SELECTED_WORKSPACE_ID" ]; then printf '"%s"' "$SELECTED_WORKSPACE_ID"; else printf 'null'; fi)" "$workspace_count"

  # Wire the MCP connection now that the key is stored (all supported hosts).
  if cmd_register >/dev/null 2>&1; then reg=0; else reg=$?; fi

  if [ "$replace" -eq 1 ]; then printf 'Updated the key for %s ✅\n' "$DETECTED_INSTANCE_NAME" >&2
  else printf 'Connected to %s ✅\n' "$DETECTED_INSTANCE_NAME" >&2; fi
  if [ "$reg" -eq 0 ]; then printf 'Beam connection registered ✅\n' >&2; fi
  if [ "$current_locked" = "1" ] && [ -n "$current_instance" ] && [ "$current_instance" != "$DETECTED_INSTANCE_ID" ]; then
    current_profile="$(profile_file "$current_instance")"
    current_name="$(file_value "$current_profile" BEAM_INSTANCE_NAME 2>/dev/null || printf '%s' "$current_instance")"
    current_workspace="$(file_value "$SESSION_FILE" BEAM_WORKSPACE_NAME 2>/dev/null || file_value "$SESSION_FILE" BEAM_WORKSPACE_ID 2>/dev/null || true)"
    printf 'This session remains on %s / %s.\n' "$current_name" "${current_workspace:-not selected}" >&2
    printf 'To use %s, start a new session and run: beam checkout %s [workspace]\n' "$DETECTED_INSTANCE_NAME" "$DETECTED_INSTANCE_ID" >&2
  elif [ -n "$SELECTED_WORKSPACE_ID" ]; then
    printf 'Checked out %s / %s ✅\n' "$DETECTED_INSTANCE_NAME" "${SELECTED_WORKSPACE_NAME:-$SELECTED_WORKSPACE_ID}" >&2
    printf 'This session is locked to this instance and workspace.\n' >&2
  else
    printf '\n🚀 Beam session setup\n' >&2
    printf '✅ Instance: %s\n' "$DETECTED_INSTANCE_NAME" >&2
    printf '⬜ Workspace\n\n' >&2
    printf 'Choose a workspace by exact name, or create a new one.\n' >&2
    printf 'Select: beam checkout %s <workspace-name>\n' "$DETECTED_INSTANCE_ID" >&2
    printf 'Create: beam workspace create <name>, then select it with beam checkout\n' >&2
  fi
}

cmd_logout() {
  if [ "$ACTIVE_INSTANCE_ID" != "" ] && [ -f "$(profile_file "$ACTIVE_INSTANCE_ID")" ]; then
    rm -f "$(profile_file "$ACTIVE_INSTANCE_ID")" "$SESSION_FILE"
    printf '{"ok":true,"loggedOut":true,"instanceId":"%s"}\n' "$ACTIVE_INSTANCE_ID"
  elif [ -f "$LEGACY_CREDS_FILE" ]; then
    rm -f "$LEGACY_CREDS_FILE"
    printf '{"ok":true,"loggedOut":true}\n'
  else
    printf '{"ok":true,"loggedOut":false}\n'
  fi
}

cmd_whoami() {
  require_instance_checkout
  raw=false
  case "${1:-}" in
    "") ;;
    --raw) raw=true ;;
    -h|--help)
      printf 'Usage: beam whoami [--raw]\n'
      printf 'Prints a compact identity and workspace summary by default. Use --raw only when the full profile is required.\n'
      return 0 ;;
    *) die "validation_error" "usage: beam whoami [--raw]" 2 ;;
  esac
  set +e; resp="$(api_read /v2/user/me)"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in or key rejected — run: beam login" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "could not reach $API_BASE (network/timeout)" 5; fi
  ws="$(read_workspace 2>/dev/null || true)"
  if [ "$raw" = true ]; then
    printf '%s\n' "$resp"
  elif command -v jq >/dev/null 2>&1; then
    printf '%s' "$resp" | jq -c --arg ws "$ws" --arg api "$API_BASE" --arg instance "$ACTIVE_INSTANCE_ID" --arg instanceName "$ACTIVE_INSTANCE_NAME" '
      (.workspaces // (if .workspace then [.workspace] else [] end)) as $workspaces |
      {
        user: {
          id: (.id // .user.id // null),
          email: (.email // .user.email // null),
          name: (.name // .user.name // .fullName // .user.fullName // null)
        },
        activeWorkspaceId: (if $ws == "" then null else $ws end),
        instanceId: (if $instance == "" then null else $instance end),
        instanceName: (if $instanceName == "" then null else $instanceName end),
        workspaceCount: ($workspaces | length),
        apiBase: $api
      }
    ' 2>/dev/null || printf '%s\n' "$resp"
  elif [ -n "$ws" ]; then
    printf '{"activeWorkspaceId":"%s","instanceId":"%s","instanceName":"%s","apiBase":"%s"}\n' "$ws" "$ACTIVE_INSTANCE_ID" "$ACTIVE_INSTANCE_NAME" "$API_BASE"
  else
    printf '{"activeWorkspaceId":null,"instanceId":"%s","instanceName":"%s","apiBase":"%s"}\n' "$ACTIVE_INSTANCE_ID" "$ACTIVE_INSTANCE_NAME" "$API_BASE"
  fi
}

cmd_workspace() {
  if [ "${1:-}" = "create" ]; then
    shift
    cmd_workspace_create "$@"
    return
  fi
  if [ "${1:-}" = "list" ]; then
    require_instance_checkout
    query="${2:-}"
    set +e; resp="$(api_read /v2/user/me)"; rc=$?; set -e
    if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in or key rejected — run: beam login" 3; fi
    if [ "$rc" -eq 5 ]; then die "network_error" "could not reach $API_BASE (network/timeout)" 5; fi
    all="$(printf '%s' "$resp" | workspaces_tsv)"
    total=0; [ -n "$all" ] && total=$(printf '%s\n' "$all" | grep -c .)
    if [ -n "$query" ]; then
      shown="$(printf '%s\n' "$all" | grep -i -- "$query" || true)"
    else
      shown="$all"
    fi
    n=0; [ -n "$shown" ] && n=$(printf '%s\n' "$shown" | grep -c .)
    if [ "$n" -eq 0 ]; then
      printf 'No workspace matched "%s" (of %s total). Try a different search.\n' "$query" "$total" >&2
      return 0
    fi
    # Accounts can hold thousands of workspaces — never dump them all.
    printf '%s\n' "$shown" | head -n 25
    if [ "$n" -gt 25 ]; then
      printf '\n… showing 25 of %s matches (%s workspaces total). Narrow it: beam workspace list <search>\n' "$n" "$total" >&2
    fi
    return 0
  fi
  require_instance_checkout
  if [ $# -eq 0 ]; then
    workspace="$(read_workspace 2>/dev/null || true)"
    if [ -z "$workspace" ]; then die "validation_error" "no workspace set — run: beam workspace list, then beam workspace <id>" 2; fi
    printf '{"workspaceId":"%s"}\n' "$workspace"
    return 0
  fi
  [ -n "$ACTIVE_INSTANCE_ID" ] || die "checkout_required" "connect an instance first with: beam login" 2
  cmd_checkout "$ACTIVE_INSTANCE_ID" "$1"
}

cmd_workspace_create() {
  prepare_scoped_session
  case "${1:-}" in
    -h|--help)
      printf 'Usage: beam workspace create <name> [--domain domain] [--icon-src url]\n'
      printf 'Creates a new workspace without changing the current workspace.\n'
      return 0 ;;
  esac
  name="${1:-}"
  [ -n "$name" ] || die "validation_error" "usage: beam workspace create <name> [--domain domain] [--icon-src url]" 2
  shift
  domain=""; icon_src=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --domain)
        [ -n "${2:-}" ] || die "validation_error" "--domain requires a value" 2
        domain="$2"; shift 2 ;;
      --icon-src)
        [ -n "${2:-}" ] || die "validation_error" "--icon-src requires a value" 2
        icon_src="$2"; shift 2 ;;
      -h|--help)
        printf 'Usage: beam workspace create <name> [--domain domain] [--icon-src url]\n'
        printf 'Creates a new workspace without changing the current workspace.\n'
        return 0 ;;
      *) die "validation_error" "unknown flag for beam workspace create: $1" 2 ;;
    esac
  done
  if [ "${#name}" -gt 30 ]; then
    die "validation_error" "workspace name must be 30 characters or fewer" 2
  fi

  name_json="$(json_quote "$name")"
  body="{\"name\":$name_json"
  if [ -n "$domain" ]; then domain_json="$(json_quote "$domain")"; body="$body,\"domain\":$domain_json"; fi
  if [ -n "$icon_src" ]; then icon_src_json="$(json_quote "$icon_src")"; body="$body,\"iconSrc\":$icon_src_json"; fi
  body="$body}"

  set +e; resp="$(api_unscoped_write POST /v2/workspace "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in or key rejected — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "workspace creation may have succeeded. Check with beam workspace list <name> before trying again." 5; fi
  printf '%s\n' "$resp"
}

cmd_agents_list() {
  if ! read_workspace >/dev/null 2>&1; then die "workspace_required" "no workspace is checked out. Run: beam checkout <instance> <workspace>" 2; fi
  # NOTE: capped at pageSize=50 (no pagination yet — deferred, see specs).
  set +e; resp="$(api_read '/agent?pageNum=1&pageSize=50')"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "agents list failed (network/timeout)" 5; fi
  printf '%s\n' "$resp"
  if printf '%s' "$resp" | json_collection_empty; then
    ws="$(read_workspace 2>/dev/null || true)"
    printf 'No agents found in workspace %s. To check another workspace, start a new session.\n' "$ws" >&2
  fi
}

cmd_agents_get() {
  id="${1:-}"
  [ -n "$id" ] || die "validation_error" "usage: beam agents get <agentId>" 2
  set +e; resp="$(api_read "/agent/$id")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 4 ]; then
    ws="$(read_workspace 2>/dev/null || true)"
    die "agent_not_found" "agent $id was not found in workspace $ws. To check another workspace, start a new session." 2
  fi
  if [ "$rc" -eq 5 ]; then die "network_error" "agents get failed (network/timeout)" 5; fi
  printf '%s\n' "$resp"
}

cmd_agents_related_get() {
  label="$1"; path="$2"; require_workspace
  set +e; resp="$(api_read "$path")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 4 ]; then die "not_found" "$label was not found in the current workspace" 2; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "$label lookup failed" 5; fi
  printf '%s\n' "$resp"
}

cmd_agents_remove_tools() {
  agent_id="${1:-}"; file="${2:-}"; confirm=""
  if [ -z "$agent_id" ] || [ -z "$file" ]; then die "validation_error" "usage: beam agents remove-tools <agentId> <payloadFile> --confirm <agentId>" 2; fi
  shift 2; while [ $# -gt 0 ]; do case "$1" in --confirm) confirm="${2:-}"; shift 2 ;; *) die "validation_error" "unknown flag for tool removal: $1" 2 ;; esac; done
  [ "$confirm" = "$agent_id" ] || die "confirmation_required" "inspect the enabled tools and obtain explicit approval, then repeat the agent id with --confirm $agent_id" 2
  body="$(read_payload_file "$file")"; require_workspace
  set +e; resp="$(api_write DELETE '/agent-chat-tools/bulk-delete' "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "tool removal result is ambiguous; re-read agent tools" 5; fi
  printf '%s\n' "$resp"
}

