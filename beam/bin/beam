template_agent_payload() {
  requested_name="$1"
  if command -v jq >/dev/null 2>&1; then
    jq --arg n "$requested_name" '(.template // .) as $t | {name:(if $n != "" then $n else ($t.title // $t.name) end),agentCategoryId:$t.agentCategoryId,themeIconUrl:$t.themeIconUrl,description:($t.longDescription // $t.shortDescription // $t.description // ""),defaultTaskId:$t.defaultTaskId,graph:$t.graph} | with_entries(select(.value != null))'
  elif command -v python3 >/dev/null 2>&1; then
    TEMPLATE_AGENT_NAME="$requested_name" python3 -c 'import json,os,sys; d=json.load(sys.stdin); t=d.get("template",d); out={"name":os.environ.get("TEMPLATE_AGENT_NAME") or t.get("title") or t.get("name"),"agentCategoryId":t.get("agentCategoryId"),"themeIconUrl":t.get("themeIconUrl"),"description":t.get("longDescription") or t.get("shortDescription") or t.get("description") or "","defaultTaskId":t.get("defaultTaskId"),"graph":t.get("graph")}; print(json.dumps({k:v for k,v in out.items() if v is not None}))'
  else
    die "internal_error" "creating from a template needs jq or python3 to preserve the graph safely" 1
  fi
}

cmd_templates_create_agent() {
  id="${1:-}"; name=""; [ -n "$id" ] || die "validation_error" "usage: beam templates create-agent <templateId> [--name name]" 2; shift
  while [ $# -gt 0 ]; do case "$1" in --name) name="${2:-}"; shift 2 ;; *) die "validation_error" "unknown flag for template agent creation: $1" 2 ;; esac; done
  require_workspace; set +e; template="$(api_read "/agent/templates/$id")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -ne 0 ]; then die "network_error" "template lookup failed; no agent was created" 5; fi
  body="$(printf '%s' "$template" | template_agent_payload "$name")"
  set +e; resp="$(api_write POST '/agent/character' "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "agent creation result is ambiguous; list agents before retrying" 5; fi
  printf '%s\n' "$resp"
}

cmd_analytics_get() {
  agent_id="${1:-}"; start="${2:-}"; end="${3:-}"; [ -n "$agent_id" ] || die "validation_error" "usage: beam analytics get <agentId> [startDate endDate]" 2
  if { [ -n "$start" ] && [ -z "$end" ]; } || { [ -z "$start" ] && [ -n "$end" ]; }; then die "validation_error" "provide both startDate and endDate" 2; fi
  require_workspace
  # Match the Copilot's default: whole agent history, not a usually-empty month.
  # The public analytics route requires both dates, so resolve createdAt first.
  if [ -z "$start" ]; then
    set +e; agent="$(api_read "/agent/$agent_id")"; agent_rc=$?; set -e
    if [ "$agent_rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
    if [ "$agent_rc" -ne 0 ]; then die "network_error" "could not resolve agent creation date for analytics" 5; fi
    if command -v jq >/dev/null 2>&1; then
      start="$(printf '%s' "$agent" | jq -r '(.createdAt // .agent.createdAt // "") | split("T")[0]' 2>/dev/null || true)"
    elif command -v python3 >/dev/null 2>&1; then
      start="$(printf '%s' "$agent" | python3 -c 'import json,sys; d=json.load(sys.stdin); print((d.get("createdAt") or (d.get("agent") or {}).get("createdAt") or "").split("T")[0])' 2>/dev/null || true)"
    fi
    [ -n "$start" ] || die "internal_error" "agent response did not include createdAt; provide an explicit analytics date range" 1
    end="$(date -u +%Y-%m-%d)"
  fi
  path="/agent-tasks/analytics?agentId=$agent_id&startDate=$start&endDate=$end"
  set +e; resp="$(api_read "$path")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "analytics lookup failed" 5; fi
  printf '%s\n' "$resp"
}

cmd_analytics_export() {
  agent_id="${1:-}"; start="${2:-}"; end="${3:-}"
  if [ -z "$agent_id" ] || [ -z "$start" ] || [ -z "$end" ]; then die "validation_error" "usage: beam analytics export <agentId> <startDate> <endDate>" 2; fi
  a="$(json_quote "$agent_id")"; s="$(json_quote "$start")"; e="$(json_quote "$end")"; body="{\"agentId\":$a,\"startDate\":$s,\"endDate\":$e}"; require_workspace
  set +e; resp="$(api_write POST '/agent-tasks/analytics/export' "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "analytics export failed" 5; fi
  printf '%s\n' "$resp"
}

