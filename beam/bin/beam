cmd_integrations_remove() {
  id="${1:-}"; confirm=""; [ -n "$id" ] || die "validation_error" "usage: beam integrations remove <providerId> --confirm <providerId>" 2
  shift; while [ $# -gt 0 ]; do case "$1" in --confirm) confirm="${2:-}"; shift 2 ;; *) die "validation_error" "unknown flag for integration removal: $1" 2 ;; esac; done
  [ "$confirm" = "$id" ] || die "confirmation_required" "obtain explicit approval, then repeat the provider id with --confirm $id" 2
  id_json="$(json_quote "$id")"; body="{\"providerId\":$id_json}"; require_workspace
  set +e; resp="$(api_write DELETE '/integration-provider/remove-connection' "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "connection removal result is ambiguous; re-read connections" 5; fi
  printf '%s\n' "$resp"
}

