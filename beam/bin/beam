  printf '%s\n' "$resp"
}

cmd_agents_upload_file() {
  agent_id="${1:-}"; file="${2:-}"
  if [ -z "$agent_id" ] || [ ! -f "$file" ]; then die "validation_error" "usage: beam agents upload-file <agentId> <localFile>" 2; fi
  require_workspace; set +e; resp="$(api_upload "/context/agent/$agent_id/file" contextFile "$file")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "context upload result is ambiguous; re-read context files before retrying" 5; fi
