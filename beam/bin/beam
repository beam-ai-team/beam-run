}

cmd_agents_transcribe() {
  file="${1:-}"; [ -f "$file" ] || die "validation_error" "usage: beam agents transcribe <localAudioFile>" 2
  require_workspace; set +e; resp="$(api_upload '/agent/transcribe-audio' audioFile "$file")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "audio transcription failed" 5; fi
  printf '%s\n' "$resp"
}

cmd_agents_deploy() {
  # Build or update an agent from a spec via the bundled agent-builder graph builder.
  # Draft by default; pass --publish to go live. See internal/agent-builder for the spec format.
  spec="${1:-}"
  [ -n "$spec" ] || die "validation_error" "usage: beam agents deploy <specFile> [--agent-id ID] [--publish] [--dry-run]" 2
  [ -f "$spec" ] || die "validation_error" "spec file not found: $spec" 2
  shift
  command -v python3 >/dev/null 2>&1 || die "internal_error" "beam agents deploy needs python3 (the graph builder). Install Python 3.8+." 1
  key="$(read_key)" || die "auth_missing" "not signed in — run beam login first" 3
  ws="$(read_workspace 2>/dev/null || true)"
  [ -n "$ws" ] || die "validation_error" "no workspace — run: beam workspace list, then beam workspace <id>" 2
  builder="$(script_dir)/../internal/agent-builder/scripts/beam.py"
  [ -f "$builder" ] || die "internal_error" "bundled graph builder not found ($builder) — reinstall the plugin (beam setup)" 1
  BEAM_API_KEY="$key" BEAM_WORKSPACE_ID="$ws" BEAM_API_URL="$API_BASE" python3 "$builder" deploy "$spec" "$@"
}

cmd_agent_builder() {
  # Passthrough to the bundled agent-builder CLI. The skill's docs used to say
  # `python3 scripts/beam.py …`, which only resolves if the agent happens to be
  # cwd'd into the skill directory — it never is, so every documented command
  # failed on a fresh install. Going through `beam` resolves the path here.
  command -v python3 >/dev/null 2>&1 || die "internal_error" "the agent builder needs python3 (3.8+). Install Python, then retry." 1
  builder="$(script_dir)/../internal/agent-builder/scripts/beam.py"
  [ -f "$builder" ] || die "internal_error" "bundled agent builder not found ($builder) — reinstall the plugin, then run: beam setup" 1
  if [ $# -eq 0 ]; then set -- --help; fi
  exec python3 "$builder" "$@"
}

cmd_agents_publish() {
  gid="${1:-}"
  [ -n "$gid" ] || die "validation_error" "usage: beam agents publish <graphId>  (graphId comes from deploy output)" 2
  set +e; resp="$(api_write PATCH "/agent-graphs/$gid/publish" '')"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "publish failed (network/timeout) — graph NOT published" 5; fi
  printf '{"ok":true,"published":"%s"}\n' "$gid"
}

cmd_agents_delete() {
  id="${1:-}"
  case "$id" in
    -h|--help)
      printf 'Usage: beam agents delete <agentId> --confirm <agentId>\n'
      printf 'Deletion is irreversible. Inspect the agent and obtain explicit user approval first.\n'
      return 0 ;;
  esac
  [ -n "$id" ] || die "validation_error" "usage: beam agents delete <agentId> --confirm <agentId>" 2
  shift || true
  confirm=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --confirm) confirm="${2:-}"; shift 2 ;;
      -h|--help)
        printf 'Usage: beam agents delete <agentId> --confirm <agentId>\n'
        printf 'Deletion is irreversible. Inspect the agent and obtain explicit user approval first.\n'
        return 0 ;;
      *) die "validation_error" "unknown flag for beam agents delete: $1" 2 ;;
    esac
  done
  [ "$confirm" = "$id" ] || die "confirmation_required" "refusing to delete $id — first inspect the agent, obtain explicit user approval, then run: beam agents delete $id --confirm $id" 2
  # DELETE /agent/{id} is JWT-gated; mint a Bearer token from the API key first.
  set +e; resp="$(api_bearer DELETE "/agent/$id" '')"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "delete auth failed (JWT exchange rejected) — run beam login again" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "delete failed (network/timeout) — agent NOT deleted" 5; fi
  printf '{"ok":true,"deleted":"%s"}\n' "$id"
}

json_quote() {
  # Quote arbitrary task input without putting it in shell history. jq is
  # preferred, with Python available on every agent-builder installation.
  if command -v jq >/dev/null 2>&1; then printf '%s' "$1" | jq -Rs .; return; fi
  if command -v python3 >/dev/null 2>&1; then
    printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))'
    return
  fi
  die "internal_error" "beam tasks test needs jq or python3 to encode task input safely" 1
}

require_workspace() {
  if ! read_workspace >/dev/null 2>&1; then
    die "workspace_required" "no workspace is checked out. Run: beam checkout <instance> <workspace>" 2
  fi
}

safe_query_value() {
  # Task ids, UUIDs, statuses, ISO dates, ordering and pagination values use this
  # conservative alphabet. Free-text search is intentionally not accepted here;
  # it would need a real URL encoder rather than shell interpolation.
  value="$1"
  case "$value" in
    *[!A-Za-z0-9_.,:@+-]*) return 1 ;;
    *) return 0 ;;
  esac
}

cmd_tasks_list() {
  require_workspace
  page=1; page_size=20; agent_id=""; statuses=""; draft=""; ordering=""
  start_date=""; end_date=""; grouping=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --agent-id) agent_id="${2:-}"; shift 2 ;;
      --statuses|--status) statuses="${2:-}"; shift 2 ;;
      --draft) draft=true; shift ;;
      --live) draft=false; shift ;;
      --ordering) ordering="${2:-}"; shift 2 ;;
      --start-date) start_date="${2:-}"; shift 2 ;;
      --end-date) end_date="${2:-}"; shift 2 ;;
      --grouping) grouping="${2:-}"; shift 2 ;;
      --page) page="${2:-}"; shift 2 ;;
      --page-size) page_size="${2:-}"; shift 2 ;;
      -h|--help)
        printf 'Usage: beam tasks list [--agent-id ID] [--statuses A,B] [--draft|--live] [--ordering VALUE] [--start-date ISO] [--end-date ISO] [--grouping status|agent] [--page N] [--page-size N]\n'
        return 0 ;;
      *) die "validation_error" "unknown flag for beam tasks list: $1" 2 ;;
    esac
  done
  for value in "$agent_id" "$statuses" "$ordering" "$start_date" "$end_date" "$grouping" "$page" "$page_size"; do
    [ -z "$value" ] || safe_query_value "$value" || die "validation_error" "unsupported character in task list filter" 2
  done
  case "$page" in ''|*[!0-9]*) die "validation_error" "--page must be a positive integer" 2 ;; esac
  case "$page_size" in ''|*[!0-9]*) die "validation_error" "--page-size must be an integer from 1 to 100" 2 ;; esac
  [ "$page" -ge 1 ] || die "validation_error" "--page must be a positive integer" 2
  if [ "$page_size" -lt 1 ] || [ "$page_size" -gt 100 ]; then die "validation_error" "--page-size must be an integer from 1 to 100" 2; fi
  path="/agent-tasks?pageNum=$page&pageSize=$page_size"
  [ -z "$agent_id" ] || path="$path&agentId=$agent_id"
  [ -z "$statuses" ] || path="$path&statuses=$statuses"
  [ -z "$draft" ] || path="$path&isDraftTask=$draft"
  [ -z "$ordering" ] || path="$path&ordering=$ordering"
  [ -z "$start_date" ] || path="$path&startDate=$start_date"
  [ -z "$end_date" ] || path="$path&endDate=$end_date"
  [ -z "$grouping" ] || path="$path&grouping=$grouping"
  set +e; resp="$(api_read "$path")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "task list failed (network/timeout)" 5; fi
  printf '%s\n' "$resp"
}

cmd_tasks_statuses() {
  agent_ids="${1:-}"; require_workspace; path='/agent-tasks/statuses'; [ -z "$agent_ids" ] || path="$path?agentIds=$agent_ids"
  set +e; resp="$(api_read "$path")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "task status lookup failed" 5; fi; printf '%s\n' "$resp"
}

cmd_tasks_agents() { cmd_agents_related_get "task agent list" '/agent-tasks/agents'; }

cmd_tasks_latest() {
  agent_id="${1:-}"; [ -n "$agent_id" ] || die "validation_error" "usage: beam tasks latest <agentId> [pageSize]" 2; page_size="${2:-10}"
  cmd_agents_related_get "latest task executions" "/agent-tasks/latest-executions?agentId=$agent_id&pageNum=1&pageSize=$page_size"
}

cmd_tasks_create() {
  agent_id="${1:-}"; task_query="${2:-}"
  if [ -z "$agent_id" ] || [ -z "$task_query" ]; then
    die "validation_error" "usage: beam tasks create <agentId> <task input> [--draft]" 2
  fi
  shift 2
  is_draft=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --draft) is_draft=true; shift ;;
      *) die "validation_error" "unknown flag for beam tasks create: $1" 2 ;;
    esac
  done
  require_workspace
  aid_json="$(json_quote "$agent_id")"
  query_json="$(json_quote "$task_query")"
  body="{\"agentId\":$aid_json,\"taskQuery\":{\"query\":$query_json},\"isDraftTask\":$is_draft}"
  set +e; resp="$(api_write POST "/agent-tasks" "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "task could not be created; reconcile with beam tasks list before retrying" 5; fi
  printf '%s\n' "$resp"
}

cmd_tasks_test() {
  agent_id="${1:-}"; task_query="${2:-}"
  if [ -z "$agent_id" ] || [ -z "$task_query" ]; then
    die "validation_error" "usage: beam tasks test <agentId> <task input>" 2
  fi

  # `isDraftTask` is the API's graph-selection flag. `isTestTask` is returned
  # by some task APIs but is ignored when supplied during task creation.
  aid_json="$(json_quote "$agent_id")"
  query_json="$(json_quote "$task_query")"
  body="{\"agentId\":$aid_json,\"taskQuery\":{\"query\":$query_json},\"isDraftTask\":true}"
  set +e; resp="$(api_write POST "/agent-tasks" "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "draft test task could not be created" 5; fi
  printf '%s\n' "$resp"
}

cmd_tasks_retry() {
  task_id="${1:-}"; feedback=""; task_node_id=""
  [ -n "$task_id" ] || die "validation_error" "usage: beam tasks retry <taskId> [--task-node-id ID --feedback text]" 2
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --task-node-id) task_node_id="${2:-}"; shift 2 ;;
      --feedback) feedback="${2:-}"; shift 2 ;;
      *) die "validation_error" "unknown flag for beam tasks retry: $1" 2 ;;
    esac
  done
  if [ -n "$feedback" ] && [ -z "$task_node_id" ]; then
    die "validation_error" "--feedback requires --task-node-id because feedback applies to a specific retry point" 2
  fi
  require_workspace
  tid_json="$(json_quote "$task_id")"
  body="{\"taskId\":$tid_json}"
  if [ -n "$task_node_id" ]; then
    node_json="$(json_quote "$task_node_id")"
    body="{\"taskId\":$tid_json,\"taskNodeId\":$node_json}"
  fi
  if [ -n "$feedback" ]; then
    feedback_json="$(json_quote "$feedback")"
    body="{\"taskId\":$tid_json,\"taskNodeId\":$node_json,\"taskNodeFeedbackAsText\":$feedback_json}"
  fi
  set +e; resp="$(api_write POST "/agent-tasks/retry" "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "task retry response was not confirmed; inspect the task before retrying again" 5; fi
  printf '%s\n' "$resp"
}

cmd_tasks_approve() {
  task_id="${1:-}"; task_node_id="${2:-}"; confirm=""
  if [ -z "$task_id" ] || [ -z "$task_node_id" ]; then die "validation_error" "usage: beam tasks approve <taskId> <taskNodeId> --confirm <taskNodeId>" 2; fi
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --confirm) confirm="${2:-}"; shift 2 ;;
      *) die "validation_error" "unknown flag for beam tasks approve: $1" 2 ;;
    esac
  done
  [ "$confirm" = "$task_node_id" ] || die "confirmation_required" "approval can trigger an external action. Obtain explicit user approval, then repeat the task node id with --confirm $task_node_id" 2
  require_workspace
  tid_json="$(json_quote "$task_id")"; node_json="$(json_quote "$task_node_id")"
  body="{\"taskNodeId\":$node_json,\"consent\":true,\"taskId\":$tid_json}"
  set +e; resp="$(api_write POST "/agent-tasks/execution/$task_id/user-consent" "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "consent result is ambiguous; inspect the task before acting again" 5; fi
  printf '%s\n' "$resp"
}

cmd_tasks_reject() {
  task_id="${1:-}"; task_node_id="${2:-}"; confirm=""; reason=""
  if [ -z "$task_id" ] || [ -z "$task_node_id" ]; then die "validation_error" "usage: beam tasks reject <taskId> <taskNodeId> --confirm <taskNodeId> [--reason text]" 2; fi
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --confirm) confirm="${2:-}"; shift 2 ;;
      --reason) reason="${2:-}"; shift 2 ;;
      *) die "validation_error" "unknown flag for beam tasks reject: $1" 2 ;;
    esac
  done
  [ "$confirm" = "$task_node_id" ] || die "confirmation_required" "rejection ends the task. Obtain explicit user approval, then repeat the task node id with --confirm $task_node_id" 2
  require_workspace
  tid_json="$(json_quote "$task_id")"; node_json="$(json_quote "$task_node_id")"
  if [ -n "$reason" ]; then feedback_json="$(json_quote "$reason")"; feedback="[$feedback_json]"; else feedback="[]"; fi
  body="{\"taskNodeId\":$node_json,\"taskId\":$tid_json,\"userFeedback\":$feedback}"
  set +e; resp="$(api_write POST "/agent-tasks/execution/$task_id/rejection" "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "rejection result is ambiguous; inspect the task before acting again" 5; fi
  printf '%s\n' "$resp"
}

cmd_tasks_abort() {
  task_id="${1:-}"; confirm=""; reason=""
  [ -n "$task_id" ] || die "validation_error" "usage: beam tasks abort <taskId> --confirm <taskId> [--reason text]" 2
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --confirm) confirm="${2:-}"; shift 2 ;;
      --reason) reason="${2:-}"; shift 2 ;;
      *) die "validation_error" "unknown flag for beam tasks abort: $1" 2 ;;
    esac
  done
  [ "$confirm" = "$task_id" ] || die "confirmation_required" "aborting ends the task. Obtain explicit user approval, then run with --confirm $task_id" 2
  require_workspace
  reason_json="$(json_quote "$reason")"; body="{\"reason\":$reason_json}"
  set +e; resp="$(api_write POST "/agent-tasks/$task_id/abort" "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "abort result is ambiguous; inspect the task before acting again" 5; fi
  printf '%s\n' "$resp"
}

cmd_tasks_delete() {
  task_id="${1:-}"; confirm=""
  [ -n "$task_id" ] || die "validation_error" "usage: beam tasks delete <taskId> --confirm <taskId>" 2
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --confirm) confirm="${2:-}"; shift 2 ;;
      *) die "validation_error" "unknown flag for beam tasks delete: $1" 2 ;;
    esac
  done
  [ "$confirm" = "$task_id" ] || die "confirmation_required" "task deletion is irreversible. Obtain explicit user approval, then run with --confirm $task_id" 2
  require_workspace
  set +e; resp="$(api_write DELETE "/agent-tasks/$task_id" '')"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "delete result is ambiguous; inspect the task list before acting again" 5; fi
  if [ -n "$resp" ]; then printf '%s\n' "$resp"; else printf '{"ok":true,"deleted":"%s"}\n' "$task_id"; fi
}

cmd_tasks_rate() {
  task_id="${1:-}"; rating="${2:-}"; feedback="${3:-}"
  if [ -z "$task_id" ] || [ -z "$rating" ]; then die "validation_error" "usage: beam tasks rate <taskId> <up|down|positive|negative> [feedback]" 2; fi
  case "$rating" in up|positive) rating=positive ;; down|negative) rating=negative ;; *) die "validation_error" "rating must be up, down, positive, or negative" 2 ;; esac
  require_workspace
  rating_json="$(json_quote "$rating")"; body="{\"rating\":$rating_json}"
  if [ -n "$feedback" ]; then feedback_json="$(json_quote "$feedback")"; body="{\"rating\":$rating_json,\"userFeedback\":$feedback_json}"; fi
  set +e; resp="$(api_write PATCH "/agent-tasks/execution/$task_id/output-rating" "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "task rating could not be confirmed" 5; fi
  printf '%s\n' "$resp"
}

cmd_tasks_cancel_wait() {
  task_node_id="${1:-}"; agent_id="${2:-}"; confirm=""
  if [ -z "$task_node_id" ] || [ -z "$agent_id" ]; then die "validation_error" "usage: beam tasks cancel-wait <taskNodeId> <agentId> --confirm <taskNodeId>" 2; fi
  shift 2; while [ $# -gt 0 ]; do case "$1" in --confirm) confirm="${2:-}"; shift 2 ;; *) die "validation_error" "unknown flag for cancel-wait: $1" 2 ;; esac; done
  [ "$confirm" = "$task_node_id" ] || die "confirmation_required" "obtain explicit approval, then repeat the waiting node id with --confirm $task_node_id" 2
  require_workspace; set +e; resp="$(api_write POST "/agent-tasks/$task_node_id/cancel-wait?agentId=$agent_id" '')"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "cancel-wait result is ambiguous; inspect the task" 5; fi; printf '%s\n' "$resp"
}

cmd_tasks_update_tool() {
  tool_name="${1:-}"; file="${2:-}"
  if [ -z "$tool_name" ] || [ -z "$file" ]; then die "validation_error" "usage: beam tasks update-tool <toolFunctionName> <payloadFile>" 2; fi
  body="$(read_payload_file "$file")"; require_workspace; set +e; resp="$(api_write PATCH "/tool/$tool_name" "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "tool update could not be confirmed" 5; fi; printf '%s\n' "$resp"
}

cmd_tasks_get() {
  task_id="${1:-}"
  [ -n "$task_id" ] || die "validation_error" "usage: beam tasks get <taskId>" 2
  set +e; resp="$(api_read "/agent-tasks/$task_id")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 4 ]; then die "task_not_found" "task $task_id was not found in the current workspace" 2; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "task lookup failed" 5; fi
  printf '%s\n' "$resp"
}

cmd_tasks_submit_input() {
  task_id="${1:-}"; task_node_id="${2:-}"; parameter="${3:-}"; answer="${4:-}"
  if [ -z "$task_id" ] || [ -z "$task_node_id" ] || [ -z "$parameter" ] || [ -z "$answer" ]; then
    die "validation_error" "usage: beam tasks submit-input <taskId> <taskNodeId> <parameter> <answer>" 2
  fi

  task_node_json="$(json_quote "$task_node_id")"
  parameter_json="$(json_quote "$parameter")"
  answer_json="$(json_quote "$answer")"
  body="{\"taskNodeId\":$task_node_json,\"userInputs\":[{\"question\":$parameter_json,\"answer\":$answer_json,\"parameter\":$parameter_json}]}"
  set +e; resp="$(api_write PATCH "/agent-tasks/execution/$task_id/user-input" "$body")"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "not signed in — run beam login first" 3; fi
  if [ "$rc" -eq 4 ]; then die "task_not_found" "task $task_id was not found in the current workspace" 2; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "task input could not be submitted" 5; fi
  printf '%s\n' "$resp"
}

read_payload_file() {
  file="${1:-}"
  if [ -z "$file" ] || [ ! -f "$file" ]; then die "validation_error" "JSON payload file not found: $file" 2; fi
  payload="$(sed -n '1,$p' "$file")"
  [ -n "$payload" ] || die "validation_error" "JSON payload file is empty: $file" 2
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$payload" | jq -e . >/dev/null 2>&1 || die "validation_error" "invalid JSON payload: $file" 2
  elif command -v python3 >/dev/null 2>&1; then
    printf '%s' "$payload" | python3 -c 'import json,sys; json.load(sys.stdin)' 2>/dev/null || die "validation_error" "invalid JSON payload: $file" 2
  fi
  printf '%s' "$payload"
}

cmd_inbox_list() {
  require_workspace
  page=1; page_size=20; type=ALL; agent_id=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --agent-id) agent_id="${2:-}"; shift 2 ;;
      --type) type="${2:-}"; shift 2 ;;
      --page) page="${2:-}"; shift 2 ;;
      --page-size) page_size="${2:-}"; shift 2 ;;
      *) die "validation_error" "unknown flag for beam inbox list: $1" 2 ;;
    esac
  done
  case "$type" in ALL|UNREAD_ONLY|READ_ONLY) ;; *) die "validation_error" "--type must be ALL, UNREAD_ONLY, or READ_ONLY" 2 ;; esac
  for value in "$agent_id" "$page" "$page_size"; do [ -z "$value" ] || safe_query_value "$value" || die "validation_error" "unsupported inbox filter" 2; done
  path="/agent-task-notification?type=$type&sortBy=createdAt&sortOrder=desc&pageNum=$page&pageSize=$page_size"
  [ -z "$agent_id" ] || path="$path&agentId=$agent_id"
  set +e; resp="$(api_bearer GET "$path" '')"; rc=$?; set -e
  if [ "$rc" -eq 3 ]; then die "auth_missing" "inbox authentication failed — run beam login again" 3; fi
  if [ "$rc" -eq 5 ]; then die "network_error" "inbox list failed" 5; fi
  trace_read_transport "$path" "bearer-direct"
  printf '%s\n' "$resp"
}

